#!/usr/bin/env bash
# S096: every merged change to a check counts as written by its worker, so an implementer is
# kept away from the families that wrote AND later fixed the check. Decision 023.
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/check_writers.sh"
setup_project
workers_toml <<'T'
planner_family = "claude"
[defaults]
implement = "standard"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
fast = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high", "pi:gemini-impl@high"]
standard = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high", "pi:gemini-impl@high"]
deep = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high", "pi:gemini-impl@high"]
[research]
fast = ["pi:deepseek-research@medium"]
[review]
standard = ["pi:gpt-review@high", "pi:deepseek-review@high"]
[plan_review]
standard = ["pi:claude-plan@high", "pi:deepseek-plan@high"]
T

for model in gpt-impl deepseek-impl claude-impl gemini-impl; do
  stub_worker "$model" <<B
work() { printf '\\n\\ndef ${model//-/_}():\\n    return 1\\n' >>shop/pricing.py; }
B
done

# t001 wrote S001's check as a DeepSeek worker; t002 later fixed it as a GPT worker.
scenario_with_check S001 pricing J1 "S001 ok"
check="evals/scenarios/S001-pricing/check"
worker_commit t001 pi:deepseek-writer@high "Write S001's check" "$check" \
  evals/scenarios/S001-pricing/scenario.md
t001_sha="$(commit_sha HEAD)"
append_check "$PROJ/$check" "fixed by t002"
worker_commit t002 pi:gpt-fixer@high "Fix S001's check" "$check"
t002_sha="$(commit_sha HEAD)"

# t004 is a different task, not one that touched S001's check; a checks_by line must still
# add its Claude family to the ones found from history.
printf 'cowriter notes\n' >"$PROJ/cowriter.txt"
worker_commit t004 pi:claude-cowriter@high "Write notes" cowriter.txt

says_skip() { # text family: a skip message that names the family and the check
  printf '%s\n' "$1" | grep -qi "skip" || return 1
  printf '%s\n' "$1" | grep -qi -- "$2" || return 1
  printf '%s\n' "$1" | grep -qF "S001" || return 1
}
name_somewhere() { # text word
  printf '%s\n' "$1" | grep -qi -- "$2"
}

write_spec t003 "Add a helper" "Add a helper." "evals/run S001"

d run t003 --dry-run
out="$OUT"
says_skip "$out" gpt || fail "the dry run didn't skip the gpt family for the later fix of S001's check, so a check's fixer can implement the work it judges: $(echo "$out" | tr '\n' ' ')"
says_skip "$out" deepseek || fail "the dry run didn't skip the deepseek family that first wrote S001's check: $(echo "$out" | tr '\n' ' ')"
{ name_somewhere "$out" t001 || name_somewhere "$out" "$t001_sha"; } \
  || fail "the dry run didn't name t001 or its merge commit as a writer of S001's check: $(echo "$out" | tr '\n' ' ')"
{ name_somewhere "$out" t002 || name_somewhere "$out" "$t002_sha"; } \
  || fail "the dry run didn't name t002 or its later merge commit as a fixer of S001's check: $(echo "$out" | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:claude-impl@high" \
  || fail "the dry run didn't offer the claude-family candidate after skipping gpt and deepseek: $(echo "$out" | grep candidate | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:gpt-impl@high" \
  && fail "the dry run still offered a gpt candidate after its fix to S001's check: $(echo "$out" | grep candidate | tr '\n' ' ')"

d run t003
[ "$RC" -eq 0 ] || fail "t003's run failed: $(echo "$OUT" | tail -3)"
says_skip "$OUT" gpt || fail "the run didn't skip the gpt family that fixed S001's check: $(echo "$OUT" | tr '\n' ' ')"
says_skip "$OUT" deepseek || fail "the run didn't skip the deepseek family that wrote S001's check: $(echo "$OUT" | tr '\n' ' ')"
[ -n "$(calls_where work claude-impl)" ] \
  || fail "t003 did not run on the claude-family candidate: $(calls_where work | tr '\n' ' ')"
[ -z "$(calls_where work gpt-impl)$(calls_where work deepseek-impl)" ] \
  || fail "t003 ran on a family that wrote or fixed S001's check: $(calls_where work | tr '\n' ' ')"

# A checks_by: line adds its tasks' families to the ones found from history.
write_spec t006 "Add another helper" "Add another helper." "evals/run S001"
spec="${OUT##*$'\n'}"
sed -i '1a checks_by: t004' "$spec"
d run t006 --dry-run
out="$OUT"
says_skip "$out" claude || fail "a checks_by: line did not add t004's claude family to the check writers from history: $(echo "$out" | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:gemini-impl@high" \
  || fail "with gpt, deepseek and claude skipped, the dry run didn't offer the gemini candidate: $(echo "$out" | grep candidate | tr '\n' ' ')"
echo "$out" | grep -Eq "candidate: pi:(gpt|deepseek|claude)-impl@high" \
  && fail "the checks_by rule left a skipped family as a candidate: $(echo "$out" | grep candidate | tr '\n' ' ')"

pass "the dry run and the run skipped the gpt and deepseek families for S001's check and named t001 and t002, and a checks_by: line added t004's claude family"
