#!/usr/bin/env bash
# S110: while the user is present, `delegate wait` (no id) returns at once when the wave lead
# parks a question, with its full text and task id, and again when the wave ends with that
# wave's summary, not only when the run stops. Decision 026.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/autopilot.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
trap ap_cleanup EXIT
ap_setup
ap_specs t001 t002 t003
ap_setup_lead 2 "t001 t002 t003" "t003=t002"
ap_write_plan "true" t001 t002 t003
flag t001 questions

# Wave 1 parks t001, then holds until the check releases it; t002 merges in wave 1. Wave 2
# (t003) holds too, so the run is still going when wave 1's end is reported.
cat >>"$AP_WORK/lead.sh" <<'LEAD'
wave() {
  case "${DELEGATE_AUTOPILOT_WAVE:-1}" in
    1)
      lead_flag wave1-started
      lead_run t001
      lead_asked && lead_park t001 "$(lead_questions_text t001)"
      lead_flag parked
      lead_wait release-1 || true
      lead_run t002
      lead_merge t002
      ;;
    2)
      lead_flag wave2-started
      lead_wait release-2 || true
      lead_run t003
      lead_merge t003
      ;;
  esac
}
LEAD

# wait_bg <n>: `delegate wait` with no id, in the background; output in wait-<n>.out, exit code
# in wait-<n>.rc once it has returned.
wait_bg() {
  rm -f "$AP_WORK/wait-$1.out" "$AP_WORK/wait-$1.rc"
  ( cd "$PROJ" && timeout 60 "$DELEGATE" wait >"$AP_WORK/wait-$1.out" 2>&1
    echo $? >"$AP_WORK/wait-$1.rc" ) &
}
wait_returned() { wait_until "$2" test -f "$AP_WORK/wait-$1.rc"; }
wait_out() { tr '\n' ' ' <"$AP_WORK/wait-$1.out" | cut -c1-300; }

ap_start
# Start waiting once the question is parked: a task's own "done" event from before that is not
# what this scenario is about; the parked item must reach the waiting lead with its text.
wait_until 60 test -f "$EVALS_WORK/flags/parked" || ap_status_fail "wave 1 never parked t001"
wait_bg 1
wait_returned 1 40 || fail "the first delegate wait did not return while a question was parked and wave 1 held: $(wait_out 1)"
[ "$(cat "$AP_WORK/wait-1.rc")" -eq 0 ] ||
  fail "the first delegate wait exited $(cat "$AP_WORK/wait-1.rc"), want 0: $(wait_out 1)"
grep -q 't001' "$AP_WORK/wait-1.out" ||
  fail "the first delegate wait does not name the parked task t001: $(wait_out 1)"
grep -qF 'Should t001 round down or to the nearest cent?' "$AP_WORK/wait-1.out" ||
  fail "the first delegate wait does not print the parked question in full: $(wait_out 1)"
[ "$(ap_get running)" = true ] ||
  ap_status_fail "the first delegate wait returned only when the run stopped, not when the item was parked"

# The next wait comes back when the wave ends, not at once and not when the run stops.
wait_bg 2
sleep 2
[ ! -f "$AP_WORK/wait-2.rc" ] ||
  fail "the second delegate wait returned while wave 1 was still held, before the wave ended: $(wait_out 2)"
flag release-1
wait_returned 2 40 || fail "the second delegate wait did not return when wave 1 ended: $(wait_out 2)"
[ "$(cat "$AP_WORK/wait-2.rc")" -eq 0 ] ||
  fail "the second delegate wait exited $(cat "$AP_WORK/wait-2.rc"), want 0: $(wait_out 2)"
grep -q 't002' "$AP_WORK/wait-2.out" ||
  fail "the wave summary does not name the merged task t002: $(wait_out 2)"
grep -qi 'gate' "$AP_WORK/wait-2.out" ||
  fail "the wave summary does not give the gate result: $(wait_out 2)"
[ "$(ap_get running)" = true ] ||
  ap_status_fail "the second delegate wait returned only when the run stopped, not when wave 1 ended"

flag release-2
ap_wait_stopped 90 || ap_status_fail "did not stop after wave 2"
pass "the first wait returned with t001's full question while wave 1 was held, the second with wave 1's summary (t002, gate) while wave 2 held the run open"
