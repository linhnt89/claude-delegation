#!/usr/bin/env bash
# Hidden scenarios changed on machine A reach machine B only when the hidden set is used.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/vault_transport.sh"
vault="$(bare_remote vault)"
recording_vault "$vault"
origin="$(bare_remote shop-origin)"
setup_machine "$VAULT_URL"
setup_project
hide_scenario S901 v1
git -C "$PROJ" push -q "$origin" HEAD:main || fail "setup: push failed"
A="$PROJ"
use_machine b
setup_machine "$VAULT_URL"
git clone -q "$origin" "$EVALS_WORK/b-shop" || fail "setup: clone failed"
B="$EVALS_WORK/b-shop"
project_evals "$B"
[ "$ERC" -eq 0 ] || fail "setup: machine B's evals failed: $EV"
echo "$EV" | grep -q "Hidden check v1.*(S901, hidden)" || fail "setup: machine B doesn't run S901: $(echo "$EV" | tail -3)"
offline() { mv "$vault" "$vault.away"; }
online() { mv "$vault.away" "$vault"; }
local_has() { git -C "$1" grep -q -F "$2" HEAD --; }
clean_vault() { [ -z "$(git -C "$1" status --porcelain)" ]; }
local_list() {
  local before
  before="$(vault_connections)"
  d list
  [ "$(vault_connections)" -eq "$before" ] || fail "delegate list contacted the vault remote"
  [ "$RC" -eq 0 ] || fail "delegate list failed: $OUT"
  echo "$OUT" | hidden_pending_note S901 || fail "delegate list didn't name S901 or a count as not on the remote yet: $OUT"
}
run_a() {
  project_evals "$A"
  [ "$ERC" -eq 0 ] || fail "machine A's evals failed: $EV"
}

# Step 1: hidden add removes the public copy, commits locally, and pushes.
use_machine main
export PROJ="$A"
hide_scenario S903 v1
[ ! -e "$A/evals/scenarios/S903-hidden-check" ] || fail "delegate hidden add left the scenario in the repo"
hidden="$(hidden_of "$A")"
vroot="$(git -C "$hidden" rev-parse --show-toplevel)"
local_has "$vroot" "S903 Hidden check v1" && clean_vault "$vroot" || fail "hidden add didn't commit the new scenario in the vault"
remote_has "$vault" "S903 Hidden check v1" || fail "delegate hidden add didn't push the new hidden scenario"

# Step 2: list is local and names the edit; the very next evals/run commits and pushes it.
f="$(grep -rl "S901 Hidden check" "$hidden" | head -1)"
[ -n "$f" ] || fail "can't find S901 in machine A's hidden folder ${hidden:-?}"
sed -i 's/Hidden check v1/Hidden check v2/' "$f"
local_list
remote_has "$vault" "S901 Hidden check v2" && fail "delegate list pushed the hand edit instead of leaving it pending"
run_a
local_has "$vroot" "S901 Hidden check v2" && clean_vault "$vroot" || fail "evals/run didn't commit the hand edit"
remote_has "$vault" "S901 Hidden check v2" || fail "evals/run didn't push the hand edit"

# Step 3: machine B pulls first and actually runs both hidden checks.
use_machine b
project_evals "$B"
[ "$ERC" -eq 0 ] || fail "machine B's evals failed: $EV"
echo "$EV" | grep -qi "pass.*Hidden check v1.*(S903, hidden)" || fail "machine B doesn't run the new hidden scenario: $(echo "$EV" | tail -4)"
echo "$EV" | grep -qi "pass.*Hidden check v2.*(S901, hidden)" || fail "machine B runs the old version of the edited hidden scenario: $(echo "$EV" | tail -4)"

# Machine A cannot push: evals/run commits, explains why, and list keeps naming it.
use_machine main
offline
sed -i 's/Hidden check v2/Hidden check v3/' "$f"
run_a
local_has "$vroot" "S901 Hidden check v3" && clean_vault "$vroot" || fail "offline evals/run didn't commit the hand edit locally"
echo "$EV" | grep -qiE 'not pushed|unpushed|not on the remote' || fail "offline evals/run didn't say the change isn't pushed: $EV"
echo "$EV" | grep -qiE 'couldn.t|could not|unable|unreachable|offline|failed|does not appear|cannot|can.t' || fail "offline evals/run didn't explain why the change isn't pushed: $EV"
local_list
local_list
online
run_a
remote_has "$vault" "S901 Hidden check v3" || fail "the next reachable evals/run didn't push the offline change"

# Machine B cannot fetch: it runs its old local copy, explaining it may be stale.
use_machine b
offline
project_evals "$B"
online
[ "$ERC" -eq 0 ] || fail "offline machine B's evals failed: $EV"
echo "$EV" | grep -qi "pass.*Hidden check v2.*(S901, hidden)" || fail "offline, machine B didn't run its local hidden copy: $(echo "$EV" | tail -3)"
echo "$EV" | grep -qiE "latest|couldn.t (check|reach)|could not (check|reach)|offline|unreachable" ||
  fail "offline, machine B didn't say it couldn't check its hidden set is the latest: $(echo "$EV" | head -3)"

# Conflicting edits: the second sync reports the conflict and a way to resolve it.
project_evals "$B"
[ "$ERC" -eq 0 ] || fail "setup: B couldn't update to v3: $EV"
use_machine main
sed -i 's/Hidden check v3/Hidden check from-A/' "$f"
run_a
remote_has "$vault" "S901 Hidden check from-A" || fail "setup: A's change wasn't pushed"
use_machine b
fb="$(grep -rl "S901 Hidden check" "$(hidden_of "$B")" | head -1)"
[ -n "$fb" ] || fail "setup: can't find B's S901"
sed -i 's/Hidden check v3/Hidden check from-B/' "$fb"
project_evals "$B"
echo "$EV" | grep -qi "conflict" || fail "both machines changed S901, and evals/run didn't report a conflict: $EV"
echo "$EV" | grep -qiE 'resolv|merge|refs/delegate/theirs' || fail "the conflict output didn't explain how to resolve it in the vault: $EV"
vb="$(git -C "$(dirname "$fb")" rev-parse --show-toplevel)"
echo "$EV" | grep -qF "$vb" || fail "the conflict output didn't name the vault to resolve it in: $EV"
git -C "$vb" log --all -p 2>/dev/null | grep -q "from-B" || grep -rq "from-B" "$vb" ||
  fail "machine B's change was lost in the conflict"
remote_has "$vault" "S901 Hidden check from-A" || fail "machine A's change was lost in the conflict"
pass "list stayed local and named pending edits; hidden runs synced; offline and conflicts were reported without loss"
