#!/usr/bin/env bash
# S117: the run report holds every waiting item in full, the answers received, the reverts
# with their reason and the decisions to confirm. Decision 026 (the 2026-10-31 report cut off
# its "Waiting for you" item mid-sentence).
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/autopilot.sh"
trap ap_cleanup EXIT
ap_setup
ap_specs t001 t002 t003
ap_setup_lead 3 "t001 t002 t003"

# The gate is red exactly while t001's file is in the autopilot checkout: t001's merge is reverted.
{ printf 'PROJ=%q\n' "$PROJ"
  cat <<'G'
wt=$(git -C "$PROJ" worktree list --porcelain | awk '/^worktree /{p=$2} /^branch refs\/heads\/autopilot$/{print p}')
if [ -e "$wt/shop/t001.py" ]; then echo "GATE-REASON: shop/t001.py breaks the build"; exit 1; fi
echo ok
G
} >"$AP_WORK/gate.sh"
ap_write_plan "sh $AP_WORK/gate.sh" t001 t002 t003

# Wave 1 merges t001 and parks t002 (a multi-line question over 500 characters, indented
# continuation lines under its bullet) and t003 (one line), then waits for the check's answer.
# A later wave runs t003 once its prompt carries the answer.
cat >>"$AP_WORK/lead.sh" <<'L'
printf '%s' "$*" >"$EVALS_WORK/autopilot/prompt-${DELEGATE_AUTOPILOT_WAVE:-0}"
wave() {
  if [ "${DELEGATE_AUTOPILOT_WAVE:-0}" = 1 ]; then
    lead_run t001; lead_merge t001
    grep -qx '## Waiting for you' PLAN.md || printf '\n## Waiting for you\n' >>PLAN.md
    cat >>PLAN.md <<'Q'
- t002: QLINE1 The worker found that totals can be rounded per line or once per order, and the two differ by a cent.
  QLINE2 Rounding per line matches the invoices the shop prints today, but it drifts on large orders.
  QLINE3 Rounding once per order is what the accounting export expects, but old invoices would stop matching.
  QLINE4 A third option rounds per line and spreads the leftover cents over the last lines, which costs a day.
  QLINE5 Whichever is chosen, the tax rounding in with_tax must follow it, or the totals will not add up.
  QLINE6 Which one should t002 implement, and may the old invoices change?
- t003: QSHORT Round down or to the nearest cent?
Q
    git add PLAN.md >/dev/null 2>&1
    git commit -qm "Plan: park t002 and t003" >/dev/null 2>&1 || true
    lead_flag parked
    lead_wait answered 60 || true
  elif grep -q 'ANSWER-NEAREST' "$EVALS_WORK/autopilot/prompt-${DELEGATE_AUTOPILOT_WAVE:-0}" 2>/dev/null; then
    awk '/^- t003:/ {next} {print}' PLAN.md >PLAN.new && mv PLAN.new PLAN.md
    git add PLAN.md >/dev/null 2>&1
    git commit -qm "Plan: t003 answered" >/dev/null 2>&1 || true
    lead_run t003; lead_merge t003
  fi
}
L

ap_start
wait_until 60 test -f "$EVALS_WORK/flags/parked" || ap_status_fail "wave 1 never parked its questions"
d autopilot answer t003 "ANSWER-NEAREST round to the nearest cent"
note "delegate autopilot answer exited $RC: $(printf '%s' "$OUT" | head -c 120)"
flag answered
ap_wait_stopped 120 || ap_status_fail "did not stop"
report="$(ap_wait_report 10)" || fail "delegate autopilot status: no run report"

section() { # <heading text>: the report's lines under "## <heading>" up to the next "## "
  awk -v h="## $1" '$0 == h {on = 1; next} /^## / {on = 0} on' "$report"
}
waiting="$(section 'Waiting for you')"
[ -n "$waiting" ] || fail "the report has no 'Waiting for you' section with the parked items"
for i in 1 2 3 4 5 6; do
  grep -q "QLINE$i" <<<"$waiting" ||
    fail "'Waiting for you' cuts off t002's question: line $i is missing (it holds: $(tr '\n' ' ' <<<"$waiting" | cut -c1-250))"
done
grep -qF 'Which one should t002 implement, and may the old invoices change?' <<<"$waiting" ||
  fail "'Waiting for you' cuts off the end of t002's question"
grep -q 'QSHORT' <<<"$waiting" || fail "'Waiting for you' does not hold t003's item"

grep -q '^## Answers received' "$report" || fail "the report has no 'Answers received' section"
answers="$(section 'Answers received')"
grep -q 't003' <<<"$answers" && grep -q 'ANSWER-NEAREST' <<<"$answers" ||
  fail "'Answers received' does not list t003's answer: $(tr '\n' ' ' <<<"$answers" | cut -c1-250)"
grep -q '^## Reverts' "$report" || fail "the report has no 'Reverts' section"
reverts="$(section 'Reverts')"
grep -q 't001' <<<"$reverts" && grep -qF 'shop/t001.py breaks the build' <<<"$reverts" ||
  fail "'Reverts' does not list t001's revert with the gate output's reason: $(tr '\n' ' ' <<<"$reverts" | cut -c1-250)"
grep -q '^## Proposed decisions to confirm' "$report" || fail "the report has no 'Proposed decisions to confirm' section"
pass "the report holds t002's six-line question whole, t003's answer, t001's revert with the gate's reason, and the decisions section"
