#!/usr/bin/env bash
# S108: the kit teaches pinned check contracts, small check tasks with a checklist, the
# question-phase check review, and `fix-check` (also for autopilot); the REPORT template has a
# `## Check problems` section. Decision 025.
#
# Observes: the text of the skills (`.claude/skills/evaluate`, `.claude/skills/delegate`) in this
# repo's root, in delegate/templates/project/ and in a fresh `delegate init` project, and the
# REPORT template in delegate/templates/ and the copy `delegate new` gives a task. Loose keyword
# matches over the lowercased, whitespace-flattened text, so rewording passes.
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE

cat >"$EVALS_WORK/kit_text.py" <<'PY'
"""Print what the kit text lacks for S108, one line per gap; exit 1 when anything is missing.

usage: kit_text.py skills <dir holding .claude/skills> | report <REPORT template file>
"""

import re
import sys
from pathlib import Path


def flat(path):
    try:
        return re.sub(r"\s+", " ", Path(path).read_text(encoding="utf-8").lower())
    except OSError:
        return ""


def has(text, pattern):
    return re.search(pattern, text) is not None


def skills(root):
    evaluate = flat(Path(root) / ".claude/skills/evaluate/SKILL.md")
    skill = flat(Path(root) / ".claude/skills/delegate/SKILL.md")
    missing = []
    if not (has(evaluate, r"\bcommand") and has(evaluate, r"exit codes?") and has(evaluate, r"(output|file)")
            and has(evaluate, r"(observe|pin|contract)")):
        missing.append("evaluate: no pinned contract (command, output or file, exit codes)")
    if not has(skill, r"(at most|no more than|max(imum)?( of)?|up to|limit(ed)? to|not more than) (5|five)\b.{0,40}scenario|\b(5|five) scenarios?.{0,20}(at most|max)"):
        missing.append("delegate: no limit of 5 scenarios per check task")
    for what, pattern in [
        ("its own data", r"own (data|fixtures?|scratch|setup)|set(s)? up (its|your) own"),
        ("no repo-history assumptions", r"history"),
        ("deterministic order", r"(determinis|sort)"),
        ("nothing from the ambient environment", r"(ambient|inherit).{0,40}environment|environment.{0,40}(ambient|inherit)"),
    ]:
        if not has(skill, pattern):
            missing.append(f"delegate: checklist lacks {what}")
    if not has(skill, r"question.phase.{0,400}(flag|report|review).{0,200}check|check.{0,200}(flag|review).{0,400}question.phase"):
        missing.append("delegate: no question-phase check review")
    if "fix-check" not in skill:
        missing.append("delegate: no fix-check")
    elif not has(skill, r"fix-check.{0,400}autopilot|autopilot.{0,400}fix-check"):
        missing.append("delegate: fix-check not taught for autopilot")
    return missing


def report(path):
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError:
        return [f"no REPORT template at {path}"]
    if not re.search(r"(?m)^## Check problems\s*$", text):
        return ["no '## Check problems' section"]
    return []


kind, target = sys.argv[1], sys.argv[2]
missing = skills(target) if kind == "skills" else report(target)
for line in missing:
    print(line)
raise SystemExit(1 if missing else 0)
PY

setup_project
d new t001
[ "$RC" -eq 0 ] || fail "setup: delegate new failed: $(echo "$OUT" | tr '\n' ' ')"

declare -A where_missing=()   # gap -> the places that have it
gaps() { # place kind target
  local out line
  out="$(python3 -I "$EVALS_WORK/kit_text.py" "$2" "$3" 2>&1)" && return 0
  while IFS= read -r line; do where_missing["$line"]+="${where_missing["$line"]:+,}$1"; done <<<"$out"
}
gaps root skills "$EVALS_ROOT"
gaps templates skills "$EVALS_ROOT/delegate/templates/project"
gaps init skills "$PROJ"
gaps REPORT.md report "$EVALS_ROOT/delegate/templates/REPORT.md"
gaps new report "$DHOME/t001/REPORT.template.md"
problems=""
while IFS= read -r line; do problems+="$line (${where_missing[$line]}); "; done < <(for gap in "${!where_missing[@]}"; do printf '%s\n' "$gap"; done | sort)
[ -z "$problems" ] || fail "the kit does not teach decision 025: $problems"

pass "the evaluate and delegate skills (root, templates and a fresh init) teach pinned contracts, small check tasks with the checklist, the question-phase review and fix-check for autopilot too; the REPORT template has '## Check problems'"
