#!/usr/bin/env bash
# S109: the user tells the lead "I'm off" and "back"; `delegate autopilot away` / `here` record
# it and `status` shows exactly what the user last said. Decision 026.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/autopilot.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
trap ap_cleanup EXIT
ap_setup

# With no autopilot run there is nothing to be away from.
d autopilot away
[ "$RC" -eq 1 ] ||
  fail "delegate autopilot away with no run exited $RC, want 1 (presence commands missing?): $OUT"
grep -qi 'autopilot start' <<<"$OUT" ||
  fail "delegate autopilot away with no run does not say to start autopilot first: $OUT"

ap_specs t001
ap_setup_lead 1 "t001"
ap_write_plan "true" t001
flag t001 slow

# presence_text: the status words a user reads, without paths that could contain either word.
presence_text() {
  d autopilot status
  grep -viE '^(worktree|log|report|branch):' <<<"$OUT"
}
expect_presence() { # <present|away> <what>
  local want="$1" other what="$2" text
  [ "$want" = present ] && other=away || other=present
  [ "$(ap_get presence)" = "$want" ] ||
    fail "delegate autopilot status --json: presence is '$(ap_get presence)' $what, want '$want'"
  text="$(presence_text)"
  grep -qiw "$want" <<<"$text" ||
    fail "delegate autopilot status does not show '$want' $what: $(echo "$text" | tr '\n' ' ')"
  grep -qiw "$other" <<<"$text" &&
    fail "delegate autopilot status shows '$other' $what, want only '$want': $(echo "$text" | tr '\n' ' ')"
  return 0
}

ap_start
wait_until 30 test -f "$EVALS_WORK/flags/t001-started" ||
  ap_status_fail "wave 1 never started t001"
expect_presence present "right after start"

d autopilot away
[ "$RC" -eq 0 ] || fail "delegate autopilot away exited $RC: $OUT"
expect_presence away "after away"

# Presence never changes on its own.
sleep 2
expect_presence away "two seconds after away, with no one saying anything"

d autopilot here
[ "$RC" -eq 0 ] || fail "delegate autopilot here exited $RC: $OUT"
expect_presence present "after here"

flag t001-release
ap_wait_stopped 90 || ap_status_fail "did not stop after the plan's only task"
pass "status showed present after start, away after away (and stayed so), present after here, and away with no run exited 1 saying to start autopilot"
