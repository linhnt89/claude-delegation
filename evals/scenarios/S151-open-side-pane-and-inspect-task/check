#!/usr/bin/env bash
# The lead opens the side pane with --beside and inspects a task with the keyboard; the
# sidebar snippet is printed, never written (decisions 038, 039).
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/herdr.sh"
setup_project
simple_workers standard gpt-busy gpt-busy gpt-busy
stub_worker gpt-busy <<'B'
work() { replay pi 0.05; wait_flag end 300; }
B
stub_worker gpt-quick <<'B'
work() { printf '\n\ndef split_bill(amount, people):\n    return round(amount / people, 2)\n' >>shop/pricing.py; }
B
trap 'flag end; kill_runs; herdr_down' EXIT
herdr_up
PI_A="/home/dev/.pi/agent/sessions/shop/2026-11-04T09-00-00_lead-a.jsonl"
CLAUDE_B="9a7d1c40-3e2b-4f58-b6a1-0d4e8c2f7193"
herdr_panes <<EOF
{"w1:p1": {"agent_session": {"source": "herdr:pi", "agent": "pi", "kind": "path", "value": "$PI_A"}},
 "w1:p2": {"agent_session": {"source": "herdr:claude", "agent": "claude", "kind": "id", "value": "$CLAUDE_B"}}}
EOF
in_pane w1:p1 write_spec t701 "Split bill" "Split a bill between people." "true"
in_pane w1:p1 write_spec t702 "Round totals" "Round totals to cents." "true"
in_pane w1:p1 write_spec t703 "$(printf 'Tax \033]0;pwned\007 table $(touch %s/pwned)' "$EVALS_WORK")" "Read tax rates." "true"
in_pane w1:p2 --claude "$CLAUDE_B" write_spec t704 "Loyalty points" "Count loyalty points." "true"
[ "$(sj 's["tasks"][0]["origin"]["value"]' t701)" = "$PI_A" ] ||
  fail "t701 has no Pi origin ($(sj 's["tasks"][0]["origin"]' t701)); S147's origin capture comes first"
d run t702 --worker pi:gpt-quick@high
[ "$(sj 's["tasks"][0]["ready_to_merge"]' t702)" = "true" ] || { echo "setup: t702 isn't ready to merge: $OUT"; exit 3; }
bg_run t701 --worker pi:gpt-busy@high
has_steps() { [ "$(sj 'len(s["tasks"][0]["steps"])' t701)" -ge 3 ] 2>/dev/null; }
wait_until 60 has_steps || { echo "setup: t701 never reported activity"; exit 3; }

# 1. --beside from the lead's pane, and from outside Herdr.
d watch --beside
[ "$RC" -ne 0 ] || fail "watch --beside outside Herdr succeeded: $OUT"
printf '%s' "$OUT" | grep -qi "herdr" || fail "watch --beside outside Herdr didn't say to run it from a Herdr lead pane: $OUT"
: >"$HLOG"
in_pane w1:p1 d watch --beside
[ "$RC" -eq 0 ] || fail "watch --beside from the lead's pane failed: $OUT"
launch="$(PROJ="$PROJ" python3 - "$HLOG" "$OUT" <<'PY'
import json, os, sys
reqs = [json.loads(l) for l in open(sys.argv[1])]
out = sys.argv[2]
splits = [r["params"] for r in reqs if r["method"] == "pane.split"]
if len(splits) != 1: print(f"FAIL: want one pane.split, got {len(splits)}"); sys.exit()
sp = splits[0]
if sp.get("target_pane_id") != "w1:p1" or sp.get("direction") != "right":
  print(f"FAIL: the split wasn't to the right of the lead's pane: {sp}"); sys.exit()
if sp.get("focus"): print("FAIL: the split took focus from the lead"); sys.exit()
if os.path.realpath(sp.get("cwd") or "") != os.path.realpath(os.environ["PROJ"]):
  print(f"FAIL: the side pane's cwd is {sp.get('cwd')!r}, want the lead's checkout"); sys.exit()
new = "w1:p101"
if new not in out: print(f"FAIL: --beside didn't print the new pane id {new}: {out!r}"); sys.exit()
for r in reqs:
  p = r["params"]
  if p.get("pane_id") == "w1:p1" and r["method"] not in ("pane.get",):
    print(f"FAIL: --beside sent {r['method']} to the lead's pane"); sys.exit()
inputs = [r["params"] for r in reqs if r["method"] in ("pane.send_input", "pane.send_text")]
if len(inputs) != 1 or inputs[0].get("pane_id") != new:
  print(f"FAIL: want one command typed into {new}, got {inputs}"); sys.exit()
text = inputs[0].get("text", "")
if os.environ["PROJ"] in text or "/" in text.replace("$DELEGATE_BIN", ""):
  print(f"FAIL: the typed command carries a path: {text!r}"); sys.exit()
for bad in ("Split", "Tax", "pwned", "t70"):
  if bad in text: print(f"FAIL: task text reached the typed command: {text!r}"); sys.exit()
print(json.dumps({"text": text, "env": sp.get("env") or {}, "cwd": sp["cwd"]}))
PY
)"
case "$launch" in FAIL:*) fail "${launch#FAIL: }" ;; esac

# 2. Run what the new pane would: its typed command in a shell, with the split's env and cwd.
cat >"$EVALS_WORK/keys.json" <<'EOF'
[{"wait": 3}, {"snap": "start"},
 {"key": "down"}, {"wait": 0.5}, {"key": "enter"}, {"wait": 2.5}, {"snap": "expanded"},
 {"key": "enter"}, {"wait": 2.5}, {"snap": "collapsed"},
 {"key": "tab"}, {"wait": 1}, {"snap": "tabbed"},
 {"key": "q"}]
EOF
mkdir -p "$EVALS_WORK/pane1"
python3 - "$launch" "$EVALS_WORK/pane-env.sh" <<'PY'
import json, shlex, sys
l = json.loads(sys.argv[1])
with open(sys.argv[2], "w") as f:
  for k, v in l["env"].items(): f.write(f"export {k}={shlex.quote(v)}\n")
  f.write(f"cd {shlex.quote(l['cwd'])}\n")
  f.write(l["text"] + "\n")
PY
side_pane() {   # side_pane <out dir> <keys json>
  ( export HERDR_ENV=1 HERDR_SOCKET_PATH="$HSOCK" HERDR_PANE_ID=w1:p101 HERDR_WORKSPACE_ID=w1 HERDR_TAB_ID=w1:t1 TERM=xterm-256color
    python3 "$EVALS_LIB/pty_keys.py" "$1" "$2" -- sh "$EVALS_WORK/pane-env.sh" )
}
side_pane "$EVALS_WORK/pane1" "$EVALS_WORK/keys.json"
[ -e "$EVALS_WORK/pwned" ] && fail "a task title was executed as a shell command"
problem="$(python3 - "$EVALS_WORK/pane1" <<'PY'
import json, os, re, sys
d = sys.argv[1]
res = json.load(open(f"{d}/result.json"))
raw = {n: open(f"{d}/{n}.raw", "rb").read() for n in ("start", "expanded", "collapsed", "tabbed", "rest")}
allraw = b"".join(raw.values())
if b"\x1b]0;pwned" in allraw or b"\x07" in allraw: print("the task title's terminal control sequence reached the screen"); sys.exit()
def text(b):
  t = b.decode("utf-8", "replace")
  t = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", t)
  t = re.sub(r"\x1b[()][A-Za-z0-9]", "", t)
  return t
def last_frame(b):
  t = b.decode("utf-8", "replace")
  for marker in ("\x1b[2J", "\x1b[H"):
    i = t.rfind(marker)
    if i != -1: t = t[i:]; break
  return text(t.encode())
start = last_frame(raw["start"])
for tid in ("t701", "t702", "t703"):
  if tid not in start: print(f"the side pane's first screen doesn't list {tid}"); sys.exit()
if "t704" in start: print("the side pane lists the other lead's task t704 among this lead's"); sys.exit()
if not re.search(r"this lead", start, re.I): print("the side pane's screen doesn't name this lead"); sys.exit()
exp = last_frame(raw["expanded"])
if "tests/test_pricing.py" not in exp or "gpt-busy" not in exp:
  print("after down + enter, t701's steps (tests/test_pricing.py) and worker (gpt-busy) aren't shown"); sys.exit()
col = last_frame(raw["collapsed"])
if "tests/test_pricing.py" in col: print("a second enter didn't collapse t701's steps"); sys.exit()
if res["killed"] or res["exit"] != 0: print(f"q didn't exit cleanly: {res}"); sys.exit()
if not res["restored"]: print(f"the terminal wasn't restored after q (lflag {res['lflag']})"); sys.exit()
PY
)"
[ -z "$problem" ] || fail "$problem"

# 3. A selected task that disappears is not replaced by another.
cat >"$EVALS_WORK/keys2.json" <<EOF
[{"wait": 3}, {"key": "down"}, {"wait": 0.3}, {"key": "down"}, {"wait": 0.3}, {"key": "enter"}, {"wait": 1},
 {"snap": "selected"}, {"flag": "$EVALS_WORK/flags/discarded"}, {"wait": 3}, {"snap": "gone"}, {"key": "q"}]
EOF
mkdir -p "$EVALS_WORK/pane2"
side_pane "$EVALS_WORK/pane2" "$EVALS_WORK/keys2.json" &
PANE2=$!   # wait for this driver only: the Herdr stand-in runs in the background too
sleep 5
d discard t703; [ "$RC" -eq 0 ] || { echo "setup: discard t703 failed: $OUT"; exit 3; }
flag discarded
wait "$PANE2"
problem="$(python3 - "$EVALS_WORK/pane2" <<'PY'
import re, sys
d = sys.argv[1]
t = open(f"{d}/gone.raw", "rb").read().decode("utf-8", "replace")
i = max(t.rfind("\x1b[2J"), t.rfind("\x1b[H"))
t = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", t[i:] if i != -1 else t)
if "no longer available" not in t: print("after the selected task was discarded, the pane didn't say 'task no longer available'"); sys.exit()
if "tests/test_pricing.py" in t: print("after the selected task was discarded, another task's details were shown"); sys.exit()
PY
)"
[ -z "$problem" ] || fail "$problem"

# 4. The sidebar snippet.
d watch --sidebar-config
[ "$RC" -eq 0 ] || fail "watch --sidebar-config failed: $OUT"
problem="$(python3 - "$OUT" <<'PY'
import re, sys, tomllib
out = sys.argv[1]
if "config.toml" not in out or not re.search(r"never (writes|edits|changes)", out, re.I):
  print("--sidebar-config doesn't say to paste it into Herdr's config.toml and that delegate never writes it"); sys.exit()
body = "\n".join(l for l in out.splitlines() if not l.startswith(("#", "note", "Paste", "paste")))
start = body.find("[ui.sidebar")
try: cfg = tomllib.loads(body[start:] if start != -1 else body)
except Exception as e: print(f"--sidebar-config isn't TOML: {e}"); sys.exit()
agents = cfg.get("ui", {}).get("sidebar", {}).get("agents", {}).get("rows_by_agent", {})
want = ["$dlg_t1", "$dlg_t2", "$dlg_t3", "$dlg_t4", "$dlg_more"]
for agent in ("pi", "claude"):
  rows = agents.get(agent)
  if not rows: print(f"--sidebar-config has no rows_by_agent.{agent}"); sys.exit()
  toks = [t if isinstance(t, str) else t.get("token") for row in rows for t in row]
  missing = [w for w in want if w not in toks]
  if missing: print(f"rows_by_agent.{agent} lacks {missing}"); sys.exit()
  for row in rows:
    for t in row:
      if isinstance(t, dict):
        for rule in t.get("rules", []):
          conds = [k for k in ("equals", "contains", "starts_with", "gt", "lt") if k in rule]
          if len(conds) != 1: print(f"a rule needs exactly one condition: {rule}"); sys.exit()
          if t["token"].startswith("$dlg_t") and conds != ["starts_with"]: print(f"{t['token']} colours by {conds[0]}, not starts_with: task text could trigger it"); sys.exit()
PY
)"
[ -z "$problem" ] || fail "$problem"
pass "--beside split right of the lead without focus and typed a fixed command; the pane listed only this lead's tasks, expanded and collapsed with keys, kept task text inert, quit with the terminal restored, reported a vanished selection, and the snippet parsed"
