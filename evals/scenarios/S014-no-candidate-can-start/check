#!/usr/bin/env bash
# Every model in the tier is out of quota or logged out.
. "$EVALS_LIB/common.sh"
setup_project
workers_toml <<'T'
[defaults]
implement = "standard"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
standard = ["pi:gpt-noauth@high", "pi:deepseek-noquota@high"]
T
stub_worker gpt-noauth <<'B'
start() { echo "Error: 401 Unauthorized" >&2; exit 1; }
B
stub_worker deepseek-noquota <<'B'
start() { echo "Error: 429 quota exceeded for this month" >&2; exit 1; }
B
write_spec t001 "Split a bill" "Add divide_bill." "python3 -m unittest -q"
d run t001
[ "$RC" -ne 0 ] || fail "run reported success with no model able to start"
for m in gpt-noauth deepseek-noquota; do echo "$OUT" | grep -q "$m" || fail "the message doesn't list $m"; done
echo "$OUT" | grep -Eqi "401|unauthorized" || fail "the message doesn't say why gpt-noauth couldn't start"
echo "$OUT" | grep -Eqi "429|quota" || fail "the message doesn't say why deepseek-noquota couldn't start"
d list
echo "$OUT" | grep "^t001" | grep -q "failed to start" || fail "list doesn't show the round as failed to start: $OUT"
if git -C "$PROJ" rev-parse -q --verify task/t001 >/dev/null; then
  [ "$(git -C "$PROJ" rev-parse task/t001)" = "$(git -C "$PROJ" rev-parse main)" ] || fail "a commit was made although no model started"
fi
pass "the failure listed each model and its reason, with no false success"
