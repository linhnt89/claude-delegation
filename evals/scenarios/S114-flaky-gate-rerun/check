#!/usr/bin/env bash
# S114: a gate that fails once by chance is rerun before anything else happens: no revert,
# no stop. Decision 026.
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/autopilot.sh"
trap ap_cleanup EXIT
ap_setup
ap_specs t001 t002
ap_setup_lead 1 "t001 t002"

# The gate fails on its first run ever (a counter file in the scratch project) and passes after.
# Every run is logged with the wave the stand-in lead had reached.
{ printf 'AP=%q\n' "$AP_WORK"
  cat <<'G'
n=$(( $(cat "$AP/gate.count" 2>/dev/null || echo 0) + 1 ))
echo "$n" >"$AP/gate.count"
waves=$(wc -l <"$AP/waves" 2>/dev/null | tr -d ' ')
if [ "$n" -eq 1 ]; then
  echo "GATE-REASON: flaky first run"; echo "$n wave=${waves:-0} red" >>"$AP/gate.log"; exit 1
fi
echo ok; echo "$n wave=${waves:-0} green" >>"$AP/gate.log"
G
} >"$AP_WORK/gate.sh"
ap_write_plan "sh $AP_WORK/gate.sh" t001 t002

ap_start
ap_wait_stopped 90 || ap_status_fail "did not stop"
reason="$(ap_get stop_reason)"
[ "$reason" = goal_met ] ||
  fail "delegate autopilot status: stop_reason is '$reason', want goal_met; one flaky gate failure ended the run (gate runs: $(tr '\n' ';' <"$AP_WORK/gate.log" 2>/dev/null))"

merged=" $(ap_merged | tr '\n' ' ') "
for id in t001 t002; do
  case "$merged" in *" $id "*) ;; *) fail "$id is not merged on autopilot (merged:$merged)" ;; esac
done
reverts="$(cd "$PROJ" && git log --format=%s autopilot | grep -c '^Revert ')"
[ "$reverts" -eq 0 ] || fail "autopilot reverted good work after one flaky gate failure ($reverts revert commits)"
[ -s "$AP_WORK/gate.log" ] || { echo "CHECK ERROR: the gate never ran"; exit 3; }
runs="$(grep -c ' wave=1 ' "$AP_WORK/gate.log")"
[ "$runs" -eq 2 ] ||
  fail "the gate ran $runs times after wave 1, want 2 (the flaky failure and one rerun): $(tr '\n' ';' <"$AP_WORK/gate.log")"
[ "$(grep ' wave=1 ' "$AP_WORK/gate.log" | sed -n '1p;2p' | awk '{print $3}' | tr '\n' ' ')" = "red green " ] ||
  fail "the gate's runs after wave 1 were not red then green: $(tr '\n' ';' <"$AP_WORK/gate.log")"
dir="$(ap_get log)"
grep -qiE 're-?run|retr(y|ied)' "$dir/autopilot.log" 2>/dev/null ||
  fail "autopilot.log does not say the gate was rerun: $(tail -5 "$dir/autopilot.log" 2>/dev/null | tr '\n' ' ')"
pass "the gate failed once, was rerun and passed; no revert, t001 and t002 merged, the run ended at goal_met"
