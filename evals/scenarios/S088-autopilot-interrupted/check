#!/usr/bin/env bash
# S088: autopilot is stopped or its driver is killed, then started again. The user is never
# locked out and the restarted run reaches the goal without merging a task twice. Decision 019.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/autopilot.sh"
trap ap_cleanup EXIT

# --- stop during wave 1, then start again ---
ap_setup
ap_specs t001 t002 t003 t004
ap_setup_lead 2 "t001 t002 t003 t004"
ap_write_plan "true" t001 t002 t003 t004
flag t001 slow
ap_start
wait_until 30 test -f "$EVALS_WORK/flags/t001-started" ||
  ap_status_fail "wave 1 never started t001"
ap_stop
[ "$(ap_get running)" = false ] || ap_status_fail "still running after delegate autopilot stop"
[ "$(ap_get stop_reason)" = stopped ] ||
  fail "delegate autopilot status: stop_reason is '$(ap_get stop_reason)', want stopped"
flag t001-release
sleep 1
kill_runs 2>/dev/null || true

ap_start
ap_wait_stopped 120 || ap_status_fail "the run after a stop did not reach the goal"
[ "$(ap_get stop_reason)" = goal_met ] ||
  fail "delegate autopilot status after a stop: stop_reason is '$(ap_get stop_reason)', want goal_met"
for id in t001 t002 t003 t004; do
  n="$(cd "$PROJ" && git log --format=%s autopilot | grep -c "^$id: ")"
  [ "$n" -eq 1 ] || fail "$id was merged $n times after the stop, want exactly one"
done

# --- kill the driver during wave 1, then start again ---
rm -rf "$PROJ" "$DHOME" "$EVALS_WORK/flags"
ap_setup
ap_specs t001 t002 t003 t004 t005
ap_setup_lead 2 "t001 t002 t003 t004"
ap_write_plan "true" t001 t002 t003 t004
flag t001 slow
ap_start
wait_until 30 test -f "$EVALS_WORK/flags/t001-started" ||
  ap_status_fail "wave 1 never started t001 before the kill"
pid="$(ap_get pid)"
[ -n "$pid" ] || ap_status_fail "status names no driver pid to kill"
kill -KILL "$pid"
ap_wait_stopped 30 || ap_status_fail "a killed driver still reads as running"
[ "$(ap_get stop_reason)" = driver_died ] ||
  fail "delegate autopilot status after killing the driver: stop_reason is '$(ap_get stop_reason)', want driver_died"

d run t005 --no-ask
[ "$RC" -eq 0 ] || fail "after the driver was killed, delegate run t005 was locked out: $OUT"

flag t001-release
sleep 1
kill_runs 2>/dev/null || true
ap_start
ap_wait_stopped 120 || ap_status_fail "the run after a killed driver did not reach the goal"
[ "$(ap_get stop_reason)" = goal_met ] ||
  fail "delegate autopilot status after a killed driver: stop_reason is '$(ap_get stop_reason)', want goal_met"
for id in t001 t002 t003 t004; do
  n="$(cd "$PROJ" && git log --format=%s autopilot | grep -c "^$id: ")"
  [ "$n" -eq 1 ] || fail "$id was merged $n times after the kill, want exactly one"
done
pass "stop and a killed driver both read as not running, the killed lock did not block delegate run, and both restarts reached the goal without double merges"
