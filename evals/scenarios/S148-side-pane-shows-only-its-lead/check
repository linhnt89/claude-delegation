#!/usr/bin/env bash
# A side pane reports only its own lead's tasks as Herdr sidebar tokens and clears them
# when that pane's conversation changes or the side pane quits (decision 038, variant B).
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/herdr.sh"
setup_project
export DELEGATE_STALL_SECS=3
simple_workers standard gpt-busy gpt-busy gpt-busy
stub_worker gpt-busy <<'B'
work() { while [ ! -f "$EVALS_WORK/flags/end" ]; do date >>notes.txt; sleep 0.5; done; }
B
stub_worker gpt-quiet <<'B'
work() { printf '\n# held\n' >>README.md; wait_flag end 300; }
B
stub_worker gpt-quick <<'B'
work() { printf '\n\ndef split_bill(amount, people):\n    return round(amount / people, 2)\n' >>shop/pricing.py; }
B
trap 'flag end; flag quit-a; flag quit-b; kill_runs; herdr_down' EXIT
herdr_up

PI_A="/home/dev/.pi/agent/sessions/shop/2026-11-04T09-00-00_lead-a.jsonl"
PI_A2="/home/dev/.pi/agent/sessions/shop/2026-11-04T11-30-00_lead-c.jsonl"
CLAUDE_B="9a7d1c40-3e2b-4f58-b6a1-0d4e8c2f7193"
panes() {   # panes <identity of A's pane, as JSON or null>
  herdr_panes <<EOF
{"w1:p1": {"agent_session": $1},
 "w1:p2": {"agent_session": {"source": "herdr:claude", "agent": "claude", "kind": "id", "value": "$CLAUDE_B"}},
 "w1:p3": {}, "w1:p4": {}}
EOF
}
panes "{\"source\": \"herdr:pi\", \"agent\": \"pi\", \"kind\": \"path\", \"value\": \"$PI_A\"}"

# Lead A: seven tasks in varied states (more than four); lead B: one.
A() { in_pane w1:p1 "$@"; }
A write_spec t301 "Split bill" "Split a bill between people." "true"
A write_spec t302 "Round totals" "Round totals to cents." "true"
A write_spec t303 "Tax table" "Read tax rates from a table." "true"
A write_spec t304 "Coupons" "Accept coupon codes." "false"
A write_spec t305 "Gift cards" "Accept gift cards." "true"
A write_spec t306 "Receipts" "Print receipts." "true"
A write_spec t307 "$(printf 'failed ‮exploit title')" "A title that looks like a state." "true"
A write_spec t308 "Refunds" "Handle refunds." "false"
in_pane w1:p2 --claude "$CLAUDE_B" write_spec t401 "Loyalty points" "Count loyalty points." "true"
[ "$(sj 's["tasks"][0]["origin"]["value"]' t301)" = "$PI_A" ] ||
  fail "t301 has no Pi origin ($(sj 's["tasks"][0]["origin"]' t301)); S147's origin capture comes first"

d run t303 --worker pi:gpt-quick@high; [ "$(sj 's["tasks"][0]["ready_to_merge"]' t303)" = "true" ] || fail "setup: t303 isn't ready to merge: $OUT"
d run t304 --worker pi:gpt-quick@high; [ "$(sj 's["tasks"][0]["outcome"]' t304)" = "fail" ] || { echo "setup: t304 didn't fail its checks: $OUT"; exit 3; }
bg_run t301 --worker pi:gpt-busy@high
bg_run t302 --worker pi:gpt-quiet@high
wait_field 60 t301 phase implement || { echo "setup: t301 never started"; exit 3; }
stalled() { [ "$(sj 's["tasks"][0]["stalled"]' t302)" = "true" ]; }
wait_until 20 stalled || { echo "setup: t302 never stalled"; exit 3; }
calls_before="$(calls | wc -l)"

# Side panes: A's piped (stopped with SIGTERM), B's in a terminal (quit with q).
side() {   # side <pane> <lead pane> <pty|pipe> <name>
  ( export HERDR_ENV=1 HERDR_SOCKET_PATH="$HSOCK" HERDR_PANE_ID="$1" HERDR_WORKSPACE_ID=w1 HERDR_TAB_ID=w1:t1
    cd "$PROJ" && exec python3 "$EVALS_LIB/watch_pane.py" "$3" "$EVALS_WORK/flags/quit-$4" "$EVALS_WORK/watch-$4.json" \
      -- "$DELEGATE" watch --lead-pane "$2" --interval 0.5 ) &
}
mkdir -p "$EVALS_WORK/flags"
side w1:p3 w1:p1 pipe a
side w1:p4 w1:p2 pty b

# tok <pane>: that pane's current tokens, as JSON (only dlg_* keys).
tok() { python3 -c 'import json,sys
t=json.load(open(sys.argv[1])).get(sys.argv[2],{})
print(json.dumps({k:v for k,v in sorted(t.items()) if k.startswith("dlg_")}, ensure_ascii=False))' "$HTOKENS" "$1" 2>/dev/null; }
tok_is() { [ "$(tok "$1")" = "$2" ]; }   # polled by wait_until: re-reads every time
want_a='{"dlg_more": "+4 more", "dlg_t1": "failed · t304", "dlg_t2": "stalled · t302", "dlg_t3": "ready · t303", "dlg_t4": "running · t301"}'
want_b='{"dlg_t1": "waiting · t401"}'
wait_until 15 tok_is w1:p1 "$want_a" || fail "A's pane tokens are $(tok w1:p1), want $want_a"
wait_until 5 tok_is w1:p2 "$want_b" || fail "B's pane tokens are $(tok w1:p2), want $want_b"
sleep 1.5
[ "$(tok w1:p1)" = "$want_a" ] || fail "A's tokens didn't stay stable: $(tok w1:p1)"
[ "$(tok w1:p3)$(tok w1:p4)" = "{}{}" ] || fail "the side panes put tokens on their own panes: $(tok w1:p3) $(tok w1:p4)"

# A task fails while watched: it moves to the front within one interval.
calls_watched="$(calls | wc -l)"   # watching alone so far
d run t308 --worker pi:gpt-quick@high
calls_after="$(calls | wc -l)"
want_a2='{"dlg_more": "+4 more", "dlg_t1": "failed · t304", "dlg_t2": "failed · t308", "dlg_t3": "stalled · t302", "dlg_t4": "ready · t303"}'
wait_until 3 tok_is w1:p1 "$want_a2" || fail "after t308 failed, A's tokens are $(tok w1:p1), want $want_a2"

# A's lead exits, then a new conversation starts in that pane: all A tokens clear.
panes null
changed_at="$(date +%s.%N)"
wait_until 3 tok_is w1:p1 "{}" || fail "A's pane lost its conversation, but its tokens stayed: $(tok w1:p1)"
panes "{\"source\": \"herdr:pi\", \"agent\": \"pi\", \"kind\": \"path\", \"value\": \"$PI_A2\"}"
sleep 2
[ "$(tok w1:p1)" = "{}" ] || fail "a new conversation in A's pane was shown A's tasks: $(tok w1:p1)"
[ "$(tok w1:p2)" = "$want_b" ] || fail "B's tokens changed when A's pane did: $(tok w1:p2)"

# Quit both: q in B's terminal, SIGTERM to A's; each sends a final clearing report.
returned_at="$(date +%s.%N)"
panes "{\"source\": \"herdr:pi\", \"agent\": \"pi\", \"kind\": \"path\", \"value\": \"$PI_A\"}"
wait_until 5 tok_is w1:p1 "$want_a2" || fail "A's tokens didn't come back when A returned: $(tok w1:p1)"
flag quit-b; flag quit-a
both_exited() { [ -f "$EVALS_WORK/watch-a.json" ] && [ -f "$EVALS_WORK/watch-b.json" ]; }
wait_until 15 both_exited || fail "the side panes didn't exit within 10 s of q / SIGTERM"
problem="$(CHANGED_AT="$changed_at" RETURNED_AT="$returned_at" python3 - "$HLOG" "$EVALS_WORK/watch-a.json" "$EVALS_WORK/watch-b.json" "$(tok w1:p1)" "$(tok w1:p2)" <<'PY'
import json, os, re, sys
log, wa, wb, ta, tb = sys.argv[1:6]
reqs = [json.loads(l) for l in open(log)]
other = sorted({r["method"] for r in reqs} - {"pane.get", "pane.report_metadata"})
if other: print(f"the side panes sent Herdr {other}; only pane.get and pane.report_metadata are allowed"); sys.exit()
reps = [r["params"] for r in reqs if r["method"] == "pane.report_metadata"]
if not reps: print("no pane.report_metadata was ever sent"); sys.exit()
keys = {"dlg_t1", "dlg_t2", "dlg_t3", "dlg_t4", "dlg_more"}
state = re.compile(r"^(failed|blocked|interrupted|unavailable|stalled|ready|checking|running|waiting|done) · t\d+$")
seqs = {}
for p in reps:
  if p.get("pane_id") not in ("w1:p1", "w1:p2"): print(f"a report went to {p.get('pane_id')}, not a lead pane"); sys.exit()
  if not isinstance(p.get("ttl_ms"), int) or p["ttl_ms"] <= 0: print(f"a report has no TTL: {p}"); sys.exit()
  if not isinstance(p.get("seq"), int): print(f"a report has no seq: {p}"); sys.exit()
  if set(p.get("tokens", {})) != keys: print(f"a report sets {sorted(p.get('tokens', {}))}, want all of {sorted(keys)}"); sys.exit()
  for k, v in p["tokens"].items():
    if v is None: continue
    if len(v) > 80 or any(ord(c) < 32 or 0x202a <= ord(c) <= 0x202e or ord(c) in (0x2028, 0x2029, 0x2066, 0x2067, 0x2068, 0x2069) for c in v):
      print(f"{k} carries a control, bidi or over-long value: {v!r}"); sys.exit()
    if k != "dlg_more" and not state.match(v): print(f"{k} = {v!r} isn't '<state> · <id>'"); sys.exit()
    if "t307" in v and not v.startswith("waiting"): print(f"t307's title made its row say {v!r}"); sys.exit()
    if any(w in v for w in ("exploit", "Split", "Coupons", "Refunds", "title")): print(f"a task title leaked into {k}: {v!r}"); sys.exit()
  last = seqs.get(p["pane_id"])
  if last is not None and p["seq"] <= last: print(f"seq didn't rise on {p['pane_id']}: {last} then {p['seq']}"); sys.exit()
  seqs[p["pane_id"]] = p["seq"]
# The pane's own reporter must clear on a conversation change, not leave it to the TTL.
changed = float(os.environ["CHANGED_AT"])
after = [r for r in reqs if r["method"] == "pane.report_metadata" and r["params"].get("pane_id") == "w1:p1" and r["at"] > changed]
if not after: print("no report reached A's pane after its conversation changed"); sys.exit()
returned = float(os.environ["RETURNED_AT"])
clears = [r for r in after if all(v is None for v in r["params"]["tokens"].values())]
if not clears or clears[0]["at"] - changed > 1.5:
  print("A's side pane didn't send a clearing report within 1.5s of the conversation change (interval 0.5s)"); sys.exit()
shown = [r for r in after if clears[0]["at"] < r["at"] < returned and any(v is not None for v in r["params"]["tokens"].values())]
if shown: print(f"after clearing, A's side pane showed tasks to the new conversation: {shown[0]['params']['tokens']}"); sys.exit()
for name, path, pane in (("A (SIGTERM)", wa, "w1:p1"), ("B (q)", wb, "w1:p2")):
  w = json.load(open(path))
  if w["killed"]: print(f"side pane {name} ignored its stop and was killed"); sys.exit()
  final = [p for p in reps if p["pane_id"] == pane][-1]
  if any(v is not None for v in final["tokens"].values()): print(f"side pane {name}'s last report doesn't clear its tokens: {final['tokens']}"); sys.exit()
if ta != "{}" or tb != "{}": print(f"tokens remain after both side panes quit: A {ta}, B {tb}"); sys.exit()
PY
)"
[ -z "$problem" ] || fail "$problem"
[ "$calls_watched" -eq "$calls_before" ] && [ "$(calls | wc -l)" -eq "$calls_after" ] ||
  fail "watching started workers: stand-in calls went $calls_before -> $calls_watched while only watching, $calls_after -> $(calls | wc -l) after t308's run"
case "$(sj 's["tasks"][0]["phase"]' t305)" in not_started|"not started") true ;; *) false ;; esac || fail "watching changed t305: phase $(sj 's["tasks"][0]["phase"]' t305)"
[ "$(sj 's["tasks"][0]["phase"]' t301)" = "implement" ] || fail "watching stopped t301: phase $(sj 's["tasks"][0]["phase"]' t301)"
pass "each side pane put only its lead's tasks in the sidebar in attention order, a failure moved up within an interval, a conversation change cleared them, titles never leaked, and quitting cleared everything"
