#!/usr/bin/env bash
# S111: while the user is present a green wave lands on the base branch on its own; once the
# user says "away", nothing lands and the report says it waits for `land`. Decision 026.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/autopilot.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
trap ap_cleanup EXIT
ap_setup
ap_specs t001 t002
ap_setup_lead 1 "t001 t002" "t002=t001"
ap_write_plan "true" t001 t002

# Wave 2 holds until the check has looked at main and said "away".
cat >>"$AP_WORK/lead.sh" <<'LEAD'
wave() {
  case "${DELEGATE_AUTOPILOT_WAVE:-1}" in
    1)
      lead_run t001
      lead_merge t001
      ;;
    2)
      lead_flag wave2-started
      lead_wait release-2 || true
      lead_run t002
      lead_merge t002
      ;;
  esac
}
LEAD

on_main() { (cd "$PROJ" && git log --format=%s main | sed -n 's/^\(t[0-9][0-9][0-9]\): .*/\1/p' | sort -u | tr '\n' ' '); }
start_main="$(cd "$PROJ" && git rev-parse main)"

ap_start
wait_until 60 test -f "$EVALS_WORK/flags/wave2-started" || ap_status_fail "wave 2 never started"

# Present: wave 1's merge is on main without anyone asking.
main_has_t001() { case " $(on_main)" in *" t001 "*) return 0 ;; esac; return 1; }
wait_until 10 main_has_t001
case " $(on_main)" in *" t001 "*) ;; *)
  fail "wave 1's gate passed while the user was present but main has no t001 merge (main merges: '$(on_main)')" ;; esac
[ "$(cd "$PROJ" && git rev-parse main)" != "$start_main" ] ||
  fail "main did not move after wave 1 although the user was present"
d wait --timeout 10s
summary="$OUT"
log_dir="$(ap_get log)"
summary="$summary $(cat "$log_dir/autopilot.log" 2>/dev/null)"
grep -q 't001' <<<"$summary" && grep -qi 'landed' <<<"$summary" ||
  fail "neither delegate wait nor autopilot.log names t001 as landed: $(echo "$summary" | tr '\n' ' ' | cut -c1-300)"

# Away: wave 2 finishes, main stays where wave 1 left it.
main_after_1="$(cd "$PROJ" && git rev-parse main)"
d autopilot away
[ "$RC" -eq 0 ] || fail "delegate autopilot away exited $RC: $OUT"
flag release-2
ap_wait_stopped 90 || ap_status_fail "did not stop after wave 2"
[ "$(ap_get stop_reason)" = goal_met ] ||
  fail "delegate autopilot status: stop_reason is '$(ap_get stop_reason)', want goal_met"
[ "$(cd "$PROJ" && git rev-parse main)" = "$main_after_1" ] ||
  fail "main moved after the user said away; nothing may land without them"
case " $(on_main)" in *" t002 "*) fail "wave 2's t002 landed on main while the user was away" ;; esac
case " $(ap_merged | tr '\n' ' ')" in *" t002 "*) ;; *)
  fail "autopilot does not hold wave 2's t002 merge (merged: $(ap_merged | tr '\n' ' '))" ;; esac
report="$(ap_wait_report 10)" || fail "delegate autopilot status: no run report was written"
grep -q 't002' "$report" && grep -qi 'land' "$report" ||
  fail "the run report does not say t002 waits for land"
pass "wave 1 landed on main while present (t001, said landed), then after away main stayed put, autopilot held t002 and the report says it waits for land"
