#!/usr/bin/env bash
# S101: a real failed round supplies the evidence for one-command, writer-family fixes.
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/check_writers.sh"
trap 'flag release-fix; kill_runs' EXIT
setup_project
# The fix must route to DeepSeek even though GPT is first in the tier.
workers_toml <<'T'
planner_family = "claude"
[defaults]
implement = "standard"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
standard = ["pi:gpt-impl@high", "pi:deepseek-fixer@high"]
[research]
fast = ["pi:deepseek-research@medium"]
[review]
standard = ["pi:gpt-review@high", "pi:deepseek-review@high"]
[plan_review]
standard = ["pi:claude-plan@high", "pi:deepseek-plan@high"]
T
stub_worker gpt-impl <<'B'
work() {
  printf '\n# implementation awaiting a corrected check\n' >>shop/pricing.py
  printf '# Report t003\n\n## Status\npartial\n\n## Check problems\nS001 reads stdout although its scenario requires stderr.\n' >.task/REPORT.md
}
B
stub_worker deepseek-fixer <<'B'
work() {
  printf '%s\n' "$PWD" >"$HOME/.cache/fix-worktree"
  wait_flag release-fix 60 >/dev/null
}
B
scenario_with_check S001 pricing J1
check="evals/scenarios/S001-pricing/check"
printf '\nContract: the diagnostic is on stderr, not stdout.\n' >>"$PROJ/evals/scenarios/S001-pricing/scenario.md"
printf '#!/usr/bin/env bash\necho "S001 stdout/stderr mismatch"\nexit 1\n' >"$PROJ/$check"
worker_commit t001 pi:deepseek-writer@high "Write S001's check" "$check" evals/scenarios/S001-pricing/scenario.md
write_spec t003 "Implement pricing" "Implement pricing without changing its check." "evals/run S001"
d run t003
[ "$RC" -eq 0 ] || fail "setup: t003 could not complete its failed round: $OUT"
grep -qF 'S001 stdout/stderr mismatch' "$DHOME/t003/CHECKS.txt" || fail "setup: S001's failure was not recorded"
grep -q '^FAIL ' "$DHOME/t003/CHECKS.txt" || fail "setup: the acceptance command did not fail"
cp "$DHOME/t003/CHECKS.txt" "$DHOME/t003/worktree/.task/CHECKS.txt"

reason='the check reads stdout but the scenario says stderr'
# Observe the held worker while supporting either a foreground or background CLI start.
(cd "$PROJ"; "$DELEGATE" fix-check S001 --from t003 --reason "$reason" >"$EVALS_WORK/fix.out" 2>&1; echo "$?" >"$EVALS_WORK/fix.rc") &
fix_pid=$!
fix_responded() { [ -f "$EVALS_WORK/fix.rc" ] || [ -f "$HOME/.cache/fix-worktree" ]; }
wait_until 30 fix_responded || fail "fix-check neither returned nor started a worker"
if [ -f "$EVALS_WORK/fix.rc" ]; then
  [ "$(<"$EVALS_WORK/fix.rc")" -eq 0 ] || fail "fix-check did not start a writer-family fix: $(<"$EVALS_WORK/fix.out")"
fi
wait_until 30 test -f "$HOME/.cache/fix-worktree" || fail "fix-check did not start the DeepSeek fix worker"
wt="$(<"$HOME/.cache/fix-worktree")"
id="$(basename "$(dirname "$wt")")"
[ "$id" != t003 ] || fail "fix-check reused the implementer's task"
d list
[ "$RC" -eq 0 ] || fail "delegate list failed: $OUT"
printf '%s\n' "$OUT" | grep -E "^$id[[:space:]].*running.*deepseek" >/dev/null \
  || fail "delegate list does not show $id running on DeepSeek: $OUT"
spec="$wt/.task/SPEC.md"
[ -f "$spec" ] || fail "the fix worker has no .task/SPEC.md"
# Require the complete scenario and failing output, not just their scenario ids.
python3 - "$PROJ/evals/scenarios/S001-pricing/scenario.md" "$DHOME/t003/CHECKS.txt" "$spec" <<'PY' || fail "the fix spec omits the scenario or failing CHECKS.txt output"
import pathlib, sys
scenario, checks, spec = (pathlib.Path(p).read_text() for p in sys.argv[1:])
assert scenario.strip() in spec
assert checks.strip() in spec
PY
grep -qF "$reason" "$spec" || fail "the fix spec omits the lead's verbatim reason"
grep -qF 'S001 reads stdout although its scenario requires stderr.' "$spec" || fail "the fix spec omits the implementer's Check problems"
grep -Eqi '(work being judged|implementer|implementation.*(report|check problems))' "$spec" \
  || fail "the fix spec does not label the Check problems as coming from the work being judged"
grep -Eq '^fixes_checks:[[:space:]]*S001[[:space:]]*$' "$spec" || fail "the fix spec lacks fixes_checks: S001"
awk '/^## Acceptance/{acceptance=1;next} /^## /{acceptance=0} acceptance' "$spec" | grep -qF 'evals/run S001' \
  || fail "the fix spec's Acceptance omits evals/run S001"
flag release-fix
wait_until 30 test -f "$EVALS_WORK/fix.rc" || fail "fix-check did not finish starting the fix"
wait "$fix_pid"
[ "$(<"$EVALS_WORK/fix.rc")" -eq 0 ] || fail "fix-check did not exit 0: $(<"$EVALS_WORK/fix.out")"
grep -qF "$id" "$EVALS_WORK/fix.out" || fail "fix-check output does not name its new task $id"
pass "pass: one command starts a DeepSeek-family fix with the scenario, failure and attributed reason"
