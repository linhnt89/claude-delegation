#!/usr/bin/env bash
. "$EVALS_LIB/common.sh"
setup_project
workers_toml <<'T'
planner_family = "claude"
[defaults]
implement = "fast"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
fast = ["claude:sonnet", "pi:openai-codex/gpt-5@high", "pi:github-copilot/gpt-4.1@high", "pi:hyper/sonnet@high"]
standard = ["claude:sonnet", "pi:openai-codex/gpt-5@high", "pi:github-copilot/gpt-4.1@high", "pi:hyper/sonnet@high"]
deep = ["claude:sonnet", "pi:openai-codex/gpt-5@high", "pi:github-copilot/gpt-4.1@high", "pi:hyper/sonnet@high"]
[research]
fast = ["pi:deepseek-research@medium"]
[review]
standard = ["pi:gpt-review@high", "pi:deepseek-review@high"]
[plan_review]
standard = ["pi:claude-plan@high", "pi:deepseek-plan@high"]
[quota]
check = true
[quota.runway]
small = "30m"
medium = "1h"
long = "3h"
T
install_stub claude
stub_worker sonnet <<'B'
work() { :; }
B
stub_worker gpt-5 <<'B'
work() { :; }
B
stub_worker gpt-4.1 <<'B'
work() { :; }
B
exec python3 "$EVALS_LIB/quota_checks.py" S071
