#!/usr/bin/env bash
. "$EVALS_LIB/lead_guard.sh"
setup_project
simple_workers
export EVALS_SEED="${EVALS_SEED:-$(python3 -c 'import random; print(random.SystemRandom().randrange(1, 1000000))')}"
export GUARD_DEADLINE="$(python3 -c 'import time; print(time.time() + 50)')"
echo "seed $EVALS_SEED (rerun with EVALS_SEED=$EVALS_SEED)"
stub_worker gpt-good <<'B'
work() { python3 "$EVALS_LIB/lead_guard.py" worker-property; }
B
write_spec t001 'Generated worker hook probes' 'Exercise realistic file paths through the installed hooks.' 'true'
exec python3 - <<'PY'
import json, os, re, subprocess, sys
from pathlib import Path
sys.path.insert(0, os.environ['EVALS_LIB'])
from lead_guard import Hooks, expect, finish, property_cases, remaining
root = Path(os.environ['PROJ'])
try:
    p = subprocess.run([os.environ['DELEGATE'], 'run', 't001'], cwd=root,
                       capture_output=True, text=True, timeout=remaining())
    expect(p.returncode == 0, 'runner-started property worker did not finish: ' + (p.stdout + p.stderr)[-250:])
except subprocess.TimeoutExpired:
    expect(False, 'runner-started guard property exceeded its 50-second budget')
receipt = Path.home() / '.cache/stub/guard-worker.json'
expect(receipt.exists(), 'runner-started worker did not exercise generated hook inputs')
if receipt.exists():
    for failure in json.loads(receipt.read_text())['failures']:
        expect(False, failure)
hooks = Hooks(root)
hooks.start()
property_cases(hooks)
# Invalid JSON, missing tool input, and a wrong-shaped input are all unreadable
# edits, rather than an excuse to silently allow a product change.
for raw in ('{', '{}', '{"tool_name":"Edit","tool_input":[]}'):
    result = hooks.call('PreToolUse', tool='Edit', path='shop/pricing.py', raw=raw)
    expect(result['blocked'] and not result['error'],
           f'malformed PreToolUse input {raw!r} was allowed; expected refused with an unreadable-input explanation')
    if result['blocked']:
        expect(bool(re.search(r'read|pars|invalid|malform|understand|JSON|input', result['reason'], re.I))
               and bool(result['reason'].strip()),
               f'malformed-input refusal did not explain it could not read the input: {result["reason"]!r}')
finish(f'path/tool/runner identity property holds (seed {os.environ["EVALS_SEED"]}); malformed inputs refused')
PY
