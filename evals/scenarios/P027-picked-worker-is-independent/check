#!/usr/bin/env bash
# P027: whatever the workers.toml and the history of check writers, the worker picked for
# implement, review and plan review is never a model it must be independent of; an excluded
# family is picked only under independence = "model" when no allowed family has a candidate;
# and a real run that used such a fallback says so and merges with `Independence: model`.
# Decisions 023, 024, 028, 029.
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/common.sh"
setup_project
exec python3 - "$@" <<'PY'
import os, re, sys
sys.path.insert(0, os.environ["EVALS_LIB"])
from kit import *

save_template()

# (candidate without effort, family, model key). The keys are known by construction: Claude
# aliases map to opus, sonnet or haiku whatever the route; every other name is unversioned, so
# its key is the last path segment.
POOL = [
    ("claude:opus", "claude", "opus"), ("claude:sonnet", "claude", "sonnet"), ("claude:haiku", "claude", "haiku"),
    ("pi:github-copilot/claude-opus-5.5", "claude", "opus"), ("pi:anthropic/sonnet", "claude", "sonnet"),
    ("pi:anthropic/haiku", "claude", "haiku"),
    ("pi:openai-codex/gpt-sol", "gpt", "gpt-sol"), ("pi:github-copilot/gpt-sol", "gpt", "gpt-sol"),
    ("codex:gpt-sol", "gpt", "gpt-sol"), ("pi:gpt-luna", "gpt", "gpt-luna"),
    ("pi:hyper/deepseek-flash", "deepseek", "deepseek-flash"), ("opencode:deepseek/deepseek-flash", "deepseek", "deepseek-flash"),
    ("pi:deepseek-pro", "deepseek", "deepseek-pro"),
    ("pi:github-copilot/gemini-argon", "gemini", "gemini-argon"), ("gemini:gemini-argon", "gemini", "gemini-argon"),
    ("pi:gemini-lite", "gemini", "gemini-lite"),
    ("pi:qwen-coder", "qwen", "qwen-coder"),
]
FAM = {b: f for b, f, _ in POOL}
KEY = {b: k for b, _, k in POOL}
PI_POOL = [e for e in POOL if e[0].startswith("pi:")]
EFFORTS = ["low", "medium", "high", "xhigh", "max"]
S = "S901"  # the scenario whose checks the generated history writes

base = lambda c: c.split("@")[0]
fam = lambda c: FAM[base(c)]
key = lambda c: KEY[base(c)]
stubname = lambda c: base(c).split(":", 1)[1].split("/", 1)[-1]
q = lambda xs: "[" + ", ".join(f'"{x}"' for x in xs) + "]"
DEFAULT_REVIEW = ["pi:gpt-review@high", "pi:deepseek-review@high"]
DEFAULT_PLAN = ["pi:claude-plan@high", "pi:deepseek-plan@high"]


def brief(out):
    """The refusal or listing, without this run's scratch paths."""
    return " ".join(out.replace(HOME, "~").split())[-220:]


def broken(msg):
    print(f"CHECK ERROR: {msg}")
    sys.exit(3)


def config(mode, implement=None, review=DEFAULT_REVIEW, plan=DEFAULT_PLAN, pfam="claude", pmodel=None):
    lines = [f'planner_family = "{pfam}"']
    if pmodel:
        lines.append(f'planner_model = "{pmodel}"')
    lines += ["[defaults]", 'implement = "standard"', 'research = "fast"', 'review = "standard"', 'plan_review = "standard"']
    if mode:
        lines.append(f'independence = "{mode}"')
    lines += ["[quota]", "check = false", "[implement]", f"standard = {q(implement or ['pi:gpt-impl@high'])}",
              "[research]", 'fast = ["pi:deepseek-research@medium"]',
              "[review]", f"standard = {q(review)}", "[plan_review]", f"standard = {q(plan)}"]
    workers("\n".join(lines) + "\n")


def history(groups):
    """A fresh project whose scenario S901 has one commit per group, each with Worker: trailers."""
    fresh()
    folder = os.path.join(PROJ, f"evals/scenarios/{S}-ledger")
    write(os.path.join(folder, "scenario.md"), f"# {S} Ledger\n- Job: J1\n- Tier: fast\n- Judged by: auto\n- Status: automated\n")
    for i, group in enumerate(groups or [[]]):
        write(os.path.join(folder, "check"), f'#!/usr/bin/env bash\necho "{S} ok"\n# revision {i}\n')
        os.chmod(os.path.join(folder, "check"), 0o755)
        git("add", "-A")
        body = "\n".join(f"Worker: {w}" for w in group)
        args = ["commit", "-qm", f"t{i + 10:03d}: Write {S}"] + (["-m", body] if body else [])
        p = sh(["git", *args])
        if p.returncode:
            broken(f"could not commit the check history: {p.stderr}")


def pick(cands, excl_fams, excl_keys, mode):
    """The oracle: (candidates the run may list, in order; whether they are a fallback)."""
    allowed = [c for c in cands if fam(c) not in excl_fams]
    if allowed:
        return allowed, False
    if mode == "model":
        fb = [c for c in cands if key(c) not in excl_keys]
        if fb:
            return fb, True
    return [], False


def listed_of(out):
    return re.findall(r"candidate: (\S+)", out)


def verdict(role, rc, out, expected, case):
    listed = listed_of(out)
    if expected:
        if rc != 0 or listed != expected:
            return f"{role} listed {listed} (exit {rc}), expected {expected}: {brief(out)}"
    elif rc == 0 or listed:
        return f"{role} should have refused but exit {rc} listed {listed}: {brief(out)}"
    return None


def implement_trial(c):
    history(c["writers"])
    config(c["mode"], implement=c["cands"])
    spec("t001", (f"evals/run {S}",))
    flat = [w for g in c["writers"] for w in g]
    expected, _ = pick(c["cands"], {fam(w) for w in flat}, {key(w) for w in flat}, c["mode"])
    rc, out = d("run", "t001", "--dry-run")
    return verdict("implement", rc, out, expected, c)


def implemented(impl):
    """A project whose t001 was implemented by `impl` (a pi candidate)."""
    fresh()
    config(None, implement=[impl])
    stub(stubname(impl), FLAGGED)
    spec("t001", (task_cmd("t001"),))
    flag("t001", "pass")
    rc, out = d("run", "t001", "--no-ask")
    if rc != 0 or "checks:   pass" not in out:
        broken(f"setup: the stand-in implementation of t001 failed (exit {rc}): {out.strip()[-200:]}")


def review_trial(c):
    implemented(c["impl"])
    config(c["mode"], implement=[c["impl"]], review=c["cands"])
    expected, _ = pick(c["cands"], {fam(c["impl"])}, {key(c["impl"])}, c["mode"])
    rc, out = d("review", "t001", "--dry-run")
    return verdict("review", rc, out, expected, c)


def plan_trial(c):
    fresh()
    config(c["mode"], plan=c["cands"], pfam=c["pfam"], pmodel=c.get("pmodel"))
    allowed = [x for x in c["cands"] if fam(x) != c["pfam"]]
    rc, out = d("plan-review", "--dry-run")
    if not allowed and c["mode"] == "model" and not c.get("pmodel"):
        # It must fall back, cannot know which model plans, and says to set planner_model.
        if rc == 0 or listed_of(out) or "planner_model" not in out:
            return f"plan review without planner_model should stop and mention planner_model (exit {rc}): {brief(out)}"
        return None
    pkeys = {c["pkey"]} if c.get("pmodel") else set()
    expected, _ = pick(c["cands"], {c["pfam"]}, pkeys, c["mode"])
    return verdict("plan review", rc, out, expected, c)


def shrink_case(trial, case, limit=25):
    """Drop list elements one at a time while the case still fails."""
    tries, changed = 0, True
    while changed and tries < limit:
        changed = False
        for field in ("writers", "cands"):
            items = case.get(field, [])
            for i in range(len(items)):
                smaller = dict(case, **{field: items[:i] + items[i + 1:]})
                if not smaller["cands"]:
                    continue
                tries += 1
                if trial(smaller):
                    case, changed = smaller, True
                    break
            if changed:
                break
    return case


def run_cases(trial, cases, s):
    for case in cases:
        problem = trial(case)
        if problem:
            small = shrink_case(trial, case)
            fail(trial(small) or problem, small, s)


rng, s = seed()
efforted = lambda b: f"{b}@{rng.choice(EFFORTS)}"


def distinct(entries, lo, hi):
    out = []
    for _ in range(rng.randint(lo, hi)):
        c = efforted(rng.choice(entries)[0])
        if c not in out:
            out.append(c)
    return out


def near(fams, entries=POOL):
    """Candidates drawn from the given families half the time: that is where fallbacks happen."""
    narrowed = [e for e in entries if e[1] in fams]
    return narrowed if narrowed and rng.random() < 0.6 else entries


MODES = [None, "family", "model", "model"]

# --- the models in the spec's examples, fixed ---
opus_x, opus_cp = "claude:opus@xhigh", "pi:github-copilot/claude-opus-5.5@high"
gpt_w = "pi:openai-codex/gpt-sol@high"
fixed_impl = [
    {"mode": "model", "writers": [[gpt_w], ["claude:opus@high"]], "cands": [gpt_w, "claude:sonnet@high"]},
    {"mode": "family", "writers": [[gpt_w], ["claude:opus@high"]], "cands": [gpt_w, "claude:sonnet@high"]},
    {"mode": None, "writers": [[gpt_w], ["claude:opus@high"]], "cands": [gpt_w, "claude:sonnet@high"]},
    {"mode": "model", "writers": [["claude:opus@high"]], "cands": [opus_x, opus_cp]},
    {"mode": "model", "writers": [["claude:opus@high"]], "cands": [opus_x, opus_cp, "pi:deepseek-pro@high"]},
]
fixed_review = [
    {"mode": "model", "impl": "pi:anthropic/sonnet@high", "cands": ["claude:sonnet@high", "claude:opus@high"]},
    {"mode": "family", "impl": "pi:anthropic/sonnet@high", "cands": ["claude:sonnet@high", "claude:opus@high"]},
    {"mode": "model", "impl": "pi:anthropic/sonnet@high", "cands": ["claude:sonnet@high", "pi:anthropic/sonnet@low"]},
]
fixed_plan = [
    {"mode": "model", "pfam": "claude", "pmodel": "opus", "pkey": "opus", "cands": ["claude:opus@high", "claude:haiku@high"]},
    {"mode": "model", "pfam": "claude", "pmodel": "claude-opus-5.5", "pkey": "opus", "cands": [opus_x, "claude:haiku@high"]},
    {"mode": "model", "pfam": "claude", "cands": ["claude:opus@high", "claude:haiku@high"]},
    {"mode": "family", "pfam": "claude", "pmodel": "opus", "pkey": "opus", "cands": ["claude:opus@high", "claude:haiku@high"]},
]

# --- seeded random configurations and histories ---
def random_writers():
    groups = []
    for _ in range(rng.randint(0, 3)):
        groups.append([efforted(rng.choice(POOL)[0]) for _ in range(rng.randint(1, 2))])
    return groups


rand_impl = []
for _ in range(12):
    groups = random_writers()
    wfams = {fam(w) for g in groups for w in g}
    rand_impl.append({"mode": rng.choice(MODES), "writers": groups, "cands": distinct(near(wfams), 1, 4)})

rand_review = []
for _ in range(7):
    impl = efforted(rng.choice(PI_POOL)[0])
    rand_review.append({"mode": rng.choice(MODES), "impl": impl, "cands": distinct(near({fam(impl)}), 1, 4)})

rand_plan = []
for _ in range(10):
    pfam = rng.choice(sorted({e[1] for e in POOL}))
    entry = rng.choice([e for e in POOL if e[1] == pfam])
    case = {"mode": rng.choice(MODES), "pfam": pfam, "cands": distinct(near({pfam}), 1, 4)}
    if rng.random() < 0.6:
        written = "claude-opus-5.5" if entry[2] == "opus" and rng.random() < 0.5 else entry[2]
        case.update(pmodel=written, pkey=entry[2])
    rand_plan.append(case)

run_cases(implement_trial, fixed_impl + rand_impl, s)
run_cases(review_trial, fixed_review + rand_review, s)
run_cases(plan_trial, fixed_plan + rand_plan, s)

# --- the real run and merge: three seeded cases, one that must fall back, one that must not ---
def real_case(index):
    for _ in range(500):
        groups = [[efforted(rng.choice(PI_POOL)[0]) for _ in range(rng.randint(1, 2))] for _ in range(rng.randint(1, 2))]
        wfams = {fam(w) for g in groups for w in g}
        mode = "model" if index == 0 else rng.choice(["family", "model"])
        cands = distinct(near(wfams, PI_POOL), 1, 4)
        expected, fallback = pick(cands, wfams, {key(w) for g in groups for w in g}, mode)
        if expected and (fallback if index == 0 else (not fallback if index == 1 else True)):
            return {"mode": mode, "writers": groups, "cands": cands}, expected, fallback
    broken("could not generate a real-run case")


for index in range(3):
    case, expected, fallback = real_case(index)
    flat = [w for g in case["writers"] for w in g]
    history(case["writers"])
    config(case["mode"], implement=case["cands"])
    for c in case["cands"]:
        stub(stubname(c), FLAGGED)
    spec("t001", (f"evals/run {S}", task_cmd("t001")))
    flag("t001", "pass")
    rc, out = d("run", "t001", "--no-ask")
    if rc != 0 or "checks:   pass" not in out:
        fail(f"delegate run stopped though {expected} may run (exit {rc}): {out.strip()[-200:]}", case, s)
    if fallback and "same-family fallback" not in out:
        fail(f"a run that fell back to {expected[0]} did not say 'same-family fallback': {out.strip()[-200:]}", case, s)
    if not fallback and "same-family fallback" in out:
        fail(f"a run with an allowed-family candidate reported a fallback: {out.strip()[-200:]}", case, s)
    rc, out = d("merge", "t001")
    if rc != 0:
        fail(f"delegate merge t001 was refused (exit {rc}): {out.strip()[-200:]}", case, s)
    trailers = git("log", "-1", "--format=%(trailers:key=Worker,valueonly)").split()
    picked = [w for w in trailers if base(w) in KEY]
    if picked != [expected[0]]:
        fail(f"the merge records Worker {trailers}, expected {expected[0]}", case, s)
    if key(picked[0]) in {key(w) for w in flat}:
        fail(f"{picked[0]} has the model key of a check writer", case, s)
    has_trailer = "Independence: model" in git("log", "-1", "--format=%(trailers:key=Independence)")
    if has_trailer != fallback:
        fail(f"the merge commit {'lacks' if fallback else 'carries'} the Independence: model trailer", case, s)

print(f"{len(fixed_impl) + len(rand_impl)} implement, {len(fixed_review) + len(rand_review)} review and "
      f"{len(fixed_plan) + len(rand_plan)} plan review configs, and 3 real merges: no picked worker shared a model "
      f"with what it checks, fallbacks only under independence = \"model\" and all reported and recorded")
PY
