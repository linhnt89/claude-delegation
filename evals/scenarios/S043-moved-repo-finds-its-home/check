#!/usr/bin/env bash
# A project in use is moved to another folder and renamed; everything should still be there.
. "$EVALS_LIB/common.sh"
trap kill_runs EXIT
setup_machine "$(bare_remote vault)"
setup_project
simple_workers standard gpt-good gpt-good gpt-good
stub_worker gpt-good <<'B'
work() { printf '\n\ndef divide_bill(a, p):\n    return a / p\n' >>shop/pricing.py; }
B
write_spec t001 "Split a bill" "Add divide_bill." "python3 -m unittest -q"
d run t001
[ -f "$DHOME/t001/SUMMARY.txt" ] || fail "setup: the first round didn't finish: $OUT"
hide_scenario S901
hide_scenario S902
d list
listed="$OUT"
echo "$listed" | grep -q t001 || fail "setup: delegate list doesn't show t001 before the move: $listed"

mkdir -p "$EVALS_WORK/projects"
mv "$PROJ" "$EVALS_WORK/projects/shop2"
export PROJ="$EVALS_WORK/projects/shop2"

d list
[ "$OUT" = "$listed" ] || fail "after the move, delegate list differs from before (it should show the task, no message): $OUT"
project_evals "$PROJ"
echo "$EV" | grep -q "S901, hidden" && echo "$EV" | grep -q "S902, hidden" || fail "after the move, evals/run doesn't run the hidden scenarios: $(echo "$EV" | tail -3)"
case "$(basename "$DHOME")" in *-shop2) ;; *) fail "the task-state folder isn't named after the renamed repo: $DHOME" ;; esac
d merge t001
[ "$RC" -eq 0 ] || fail "merge after the move failed: $OUT"
[ ! -e "$DHOME/t001" ] || fail "merge after the move left task state in $DHOME/t001"
git -C "$PROJ" rev-parse -q --verify task/t001 >/dev/null && fail "merge after the move left the task branch"

# Moved while a task runs in the background: found, or interrupted with a hint that works.
stub_worker gpt-slow <<'B'
work() { wait_flag go 60; printf '\n\ndef tip(a):\n    return round(a * 0.1, 2)\n' >>shop/pricing.py; }
B
SCOPE='`shop/pricing.py`' write_spec t002 "Add a tip" "Add tip." "python3 -m unittest -q"
bg_run t002 --no-ask --worker pi:gpt-slow@high
[ "$RC" -eq 0 ] || fail "setup: background run failed to start: $OUT"
wait_until 30 test -n "$(calls_where work gpt-slow)" || fail "setup: the background worker never started"
mv "$PROJ" "$EVALS_WORK/shop3"
export PROJ="$EVALS_WORK/shop3"
flag go
wait_until 60 sh -c "cd '$PROJ' && '$DELEGATE' list 2>&1 | grep -q 't002.*\\(done\\|interrupted\\)'" ||
  { d list; fail "a task running during the move is neither done nor interrupted: $OUT"; }
d list
if echo "$OUT" | grep -q 't002.*interrupted'; then
  d discard t002
  [ "$RC" -eq 0 ] || fail "the interrupted task's hint didn't work: discard failed: $OUT"
else
  d merge t002
  [ "$RC" -eq 0 ] || fail "the task that finished during the move can't be merged: $OUT"
fi
d list
echo "$OUT" | grep -q t002 && fail "t002 is still listed after it was finished off: $OUT"
pass "after a move and a rename, the task, the hidden scenarios and merging all worked as before"
