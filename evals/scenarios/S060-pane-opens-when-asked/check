#!/usr/bin/env bash
# Tasks start in this session and in others: no pane opens by itself, the row shows them.
. "$EVALS_LIB/common.sh"
. "$EVALS_LIB/mod.sh"
setup_project
python3 - "$PROJ/.claude/settings.json" <<'PY' || exit 1
import json, os, sys
s = json.load(open(sys.argv[1])) if os.path.exists(sys.argv[1]) else {}
if "delegate statusline" in json.dumps(s.get("statusLine", "")):
    print("FAIL: delegate init set up a status line that repeats the tasks the row above the prompt shows"); sys.exit(1)
PY
mod_check "$EVALS_SCENARIO/mod.test.tsx"
pass "no pane opened by itself, the row showed new tasks in the app and the terminal, and the pane stayed open until closed"
