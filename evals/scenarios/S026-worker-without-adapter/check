#!/usr/bin/env bash
# A worker prints plain text that no adapter understands.
. "$EVALS_LIB/common.sh"
setup_project
simple_workers standard gpt-plain gpt-plain gpt-plain
trap 'flag end; kill_runs' EXIT
stub_worker gpt-plain <<'B'
work() {
  echo "Looking at the pricing module now"
  printf '\n\ndef divide_bill(amount, people):\n    return round(amount / people, 2)\n' >>shop/pricing.py
  echo "Added divide_bill, waiting on the next bit"
  wait_flag end
}
B
write_spec t001 "Split a bill" "Add divide_bill." "grep -q divide_bill shop/pricing.py"
bg_run t001
[ "$RC" -eq 0 ] || fail "run --background failed: $OUT"
wait_until 30 grep -q pricing.py <<<"$(sj 's["tasks"][0]["changed_files"]' t001)" || fail "status never showed the changed file"
[ "$(sj 's["tasks"][0]["steps_available"]' t001)" = false ] || fail "status --json claims step details for a worker it can't read"
d status t001
[ "$RC" -eq 0 ] || fail "status failed: $OUT"
for want in implement pricing.py "waiting on the next bit"; do
  echo "$OUT" | grep -qF "$want" || fail "status doesn't show '$want': $OUT"
done
echo "$OUT" | grep -Eqi "step details? (aren't|are not|not) available|no step details" \
  || fail "status doesn't say step details aren't available for this worker: $OUT"
pass "for a worker with unreadable output, status showed phase, changed files and the log tail, and said steps aren't available"
