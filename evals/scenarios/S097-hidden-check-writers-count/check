#!/usr/bin/env bash
# S097: a hidden check's writers are kept away from the work it judges, without naming the
# hidden scenario to the worker. Decision 023.
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/check_writers.sh"
trap kill_runs EXIT
setup_machine "$(bare_remote vault)"
setup_project
workers_toml <<'T'
planner_family = "claude"
[defaults]
implement = "standard"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
fast = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high"]
standard = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high"]
deep = ["pi:gpt-impl@high", "pi:deepseek-impl@high", "pi:claude-impl@high"]
[research]
fast = ["pi:deepseek-research@medium"]
[review]
standard = ["pi:gpt-review@high", "pi:deepseek-review@high"]
[plan_review]
standard = ["pi:claude-plan@high", "pi:deepseek-plan@high"]
T

for model in gpt-impl deepseek-impl claude-impl; do
  stub_worker "$model" <<B
work() { printf '\\n\\ndef ${model//-/_}():\\n    return 1\\n' >>shop/pricing.py; }
B
done
# The worker goes looking for hidden material; its committed notes let the check see what it found.
stub_worker deepseek-impl <<'B'
work() {
  printf '
  
def deepseek_impl():
    return 1
' >>shop/pricing.py
  {
    grep -r "Hidden check S002-marker\|Hidden check S003-marker\|Hidden check S002-hidden" \
      "$HOME/.local/share/delegate" "$PWD" 2>/dev/null
    find "$HOME/.local/share/delegate" -name 'S002-*' -o -name 'S003-*' 2>/dev/null
  } >seen-hidden.txt
}
B

# t001 wrote the checks for S001 and S002 (both job J1) as a GPT worker.
scenario_with_check S001 pricing J1 "S001 ok"
scenario_with_check S002 pricing J1 "Hidden check S002-marker"
worker_commit t001 pi:gpt-writer@high "Write the J1 checks" \
  evals/scenarios/S001-pricing/check evals/scenarios/S001-pricing/scenario.md \
  evals/scenarios/S002-pricing/check evals/scenarios/S002-pricing/scenario.md

# t004 wrote hidden S003 for job J2 as a Claude worker; it must not make Claude a writer here.
scenario_with_check S003 reports J2 "Hidden check S003-marker"
worker_commit t004 pi:claude-writer@high "Write the J2 check" \
  evals/scenarios/S003-reports/check evals/scenarios/S003-reports/scenario.md

d hidden add evals/scenarios/S002-pricing
[ "$RC" -eq 0 ] || fail "setup: could not hide S002: $OUT"
git -C "$PROJ" add -A
git -C "$PROJ" commit -qm "Hide S002" -m "Worker: pi:gpt-writer@high"
d hidden add evals/scenarios/S003-reports
[ "$RC" -eq 0 ] || fail "setup: could not hide S003: $OUT"
git -C "$PROJ" add -A
git -C "$PROJ" commit -qm "Hide S003" -m "Worker: pi:claude-writer@high"

write_spec t003 "Add a helper" "Add a helper." "evals/run S001"
d run t003 --dry-run
out="$OUT"
skip_lines="$(echo "$out" | grep -i "skip")"
[ -n "$skip_lines" ] || fail "the dry run did not skip the gpt family that wrote S001's check and a hidden check for the same job: $(echo "$out" | tr '\n' ' ')"
echo "$skip_lines" | grep -qi "gpt" || fail "the dry run's skip message did not name the gpt family that wrote S001's check and a hidden check for the same job: $(echo "$out" | tr '\n' ' ')"
echo "$skip_lines" | grep -qF "S001" || fail "the dry run's skip message did not name the visible check S001: $(echo "$out" | tr '\n' ' ')"
echo "$skip_lines" | grep -qi "hidden" || fail "the dry run did not say a hidden check was among the skipped writers: $(echo "$out" | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:deepseek-impl@high" \
  || fail "the dry run did not offer the deepseek candidate after skipping gpt: $(echo "$out" | grep candidate | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:gpt-impl@high" \
  && fail "the dry run still offered a gpt candidate although gpt wrote S001's and hidden S002's checks: $(echo "$out" | grep candidate | tr '\n' ' ')"
echo "$out" | grep -qi "skipping the claude family" \
  && fail "the dry run skipped the claude family although hidden S003 judges another job: $(echo "$out" | tr '\n' ' ')"
echo "$out" | grep -q "candidate: pi:claude-impl@high" \
  || fail "the dry run hid the claude candidate although hidden S003 judges another job: $(echo "$out" | grep candidate | tr '\n' ' ')"
for secret in S002 S003 S002-marker S003-marker; do
  echo "$out" | grep -qF -- "$secret" \
    && fail "the run named hidden material ($secret): $(echo "$out" | tr '\n' ' ')"
done

d run t003
[ "$RC" -eq 0 ] || fail "t003's run failed: $(echo "$OUT" | tail -3)"
run_skips="$(echo "$OUT" | grep -i "skip")"
[ -n "$run_skips" ] || fail "the run did not skip the gpt family for the checks of S001 and a hidden scenario: $(echo "$OUT" | tr '\n' ' ')"
echo "$run_skips" | grep -qi "gpt" || fail "the run's skip message did not name the gpt family it skipped: $(echo "$OUT" | tr '\n' ' ')"
echo "$run_skips" | grep -qi "hidden" || fail "the run did not say a hidden check's writer was skipped: $(echo "$OUT" | tr '\n' ' ')"
[ -n "$(calls_where work deepseek-impl)" ] \
  || fail "t003 did not run on the deepseek-family candidate: $(calls_where work | tr '\n' ' ')"
[ -z "$(calls_where work gpt-impl)" ] \
  || fail "t003 ran on the gpt family that wrote S001's and hidden S002's checks: $(calls_where work | tr '\n' ' ')"
for secret in S002 S003 S002-marker S003-marker; do
  echo "$OUT" | grep -qF -- "$secret" \
    && fail "the run named hidden material ($secret): $(echo "$OUT" | tr '\n' ' ')"
done
# An empty file is fine: a sandboxed worker that can read nothing hidden writes one.
git -C "$PROJ" cat-file -e task/t003:seen-hidden.txt 2>/dev/null \
  || fail "setup: the worker's seen-hidden.txt wasn't committed"
seen="$(git -C "$PROJ" show task/t003:seen-hidden.txt 2>/dev/null)"
for secret in S002 S003 S002-marker S003-marker; do
  echo "$seen" | grep -qF -- "$secret" && fail "the worker could read hidden material ($secret)"
done

pass "t003 ran on the deepseek family, the run skipped gpt for S001 and a hidden scenario without naming it, claude still ran, and the worker could not read the hidden set"
