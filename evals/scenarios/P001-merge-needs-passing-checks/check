#!/usr/bin/env bash
. "$EVALS_LIB/common.sh"
setup_project
simple_workers standard gpt-flag gpt-flag gpt-flag
exec python3 - "$@" <<'PY'
import os, sys
sys.path.insert(0, os.environ["EVALS_LIB"])
from kit import *

# Merge never lands work whose checks didn't pass, for any sequence of runs, fixes, checks, merges.
stub("gpt-flag", FLAGGED)
save_template()
CMD = task_cmd("t001")

def play(case):
    """Replay a case; return a problem string or None."""
    fresh(); spec("t001", (CMD,))
    wt = os.path.join(DHOME, "t001", "worktree")
    content, last_check = None, None          # model: what the branch holds; (commit, passed)
    for step in case:
        act, arg = step
        if act == "run":
            flag("t001", arg); d("run", "t001", "--no-ask")
            if arg in ("pass", "fail"):
                content = arg
            if os.path.isdir(wt):
                last_check = (git("rev-parse", "task/t001"), content == "pass")
        elif act == "fix" and os.path.isdir(wt):
            write(os.path.join(wt, "shop/split_t001.py"), GOOD if arg == "pass" else BAD)
            sh("git add -A && git commit -qm fix", cwd=wt)
            content = arg
        elif act == "check":
            rc, _ = d("check", "t001")
            if rc == 0:
                last_check = (git("rev-parse", "task/t001"), content == "pass")
        elif act == "merge":
            main_before = (git("rev-parse", "main"), git("status", "--porcelain"))
            head = git("rev-parse", "task/t001") if os.path.isdir(wt) else None
            rc, out = d("merge", "t001")
            allowed = content is not None and last_check == (head, True)
            if rc == 0 and not allowed:
                return f"merge succeeded although checks hadn't passed on the final commit (last check {last_check}, final {head})"
            if rc != 0 and (git("rev-parse", "main"), git("status", "--porcelain")) != main_before:
                return "a refused merge changed main"
            if rc == 0:
                return None
    return None

rng, s = seed()
for i in range(12):
    case = [rng.choice([("run", rng.choice(["pass", "fail"])), ("fix", rng.choice(["pass", "fail"])),
                        ("check", None), ("merge", None)]) for _ in range(rng.randint(2, 7))]
    case.append(("merge", None))
    problem = play(case)
    if problem:
        small = shrink(case, lambda c: play(c) is not None)
        fail(play(small) or problem, small, s)
print("12 sequences: merge only ever landed work whose final commit passed its checks")
PY
