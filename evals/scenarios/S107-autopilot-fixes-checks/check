#!/usr/bin/env bash
# S107: autopilot's lead judges a failure a check bug and runs `delegate fix-check`; the fix task
# runs on the family that wrote the check, and the run report lists it with S001 and the reason.
# Decision 025 (amends 019).
#
# Observes: the lead's log (the stand-in lead runs `delegate fix-check S001 --from t003 --reason
# "…"` and records its exit code and output), the stand-in workers' recorded calls (the fix's
# spec carries `fixes_checks: S001`; its model says the family), and `report.md` from
# `delegate autopilot status` (one line naming S001 and the reason).
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/autopilot.sh"
. "$EVALS_LIB/check_writers.sh"
trap ap_cleanup EXIT

REASON="the check always exits 1 whatever the product does"

ap_setup
workers_toml <<'T'
planner_family = "claude"
[defaults]
implement = "standard"
research = "fast"
review = "standard"
plan_review = "standard"
[implement]
fast = ["pi:gpt-impl@high", "pi:deepseek-impl@high"]
standard = ["pi:gpt-impl@high", "pi:deepseek-impl@high"]
deep = ["pi:gpt-impl@high", "pi:deepseek-impl@high"]
[research]
fast = ["pi:deepseek-research@medium"]
[review]
standard = ["pi:gpt-review@high", "pi:deepseek-review@high"]
[plan_review]
standard = ["pi:claude-plan@high", "pi:deepseek-plan@high"]
T
# t003's implementer: the product is fine, the check is not, and it says so in its report.
stub_worker gpt-impl <<'B'
work() {
  printf '\n\ndef gpt_t003():\n    return 1\n' >>shop/pricing.py
  printf '# Report t003\n\n## Check problems\n- S001: its check exits 1 whatever the code does.\n' >.task/REPORT.md
}
B
# The writers' family, asked to fix the check: it does.
stub_worker deepseek-impl <<'B'
work() {
  printf '#!/usr/bin/env bash\necho "S001 ok"\n' >evals/scenarios/S001-pricing/check
}
B

# S001's check was written by the DeepSeek family and is broken.
scenario_with_check S001 pricing J1 "S001 ok"
printf '#!/usr/bin/env bash\necho "S001 broken"\nexit 1\n' >"$PROJ/evals/scenarios/S001-pricing/check"
worker_commit t001 pi:deepseek-writer@high "Write S001's check" \
  evals/scenarios/S001-pricing/check evals/scenarios/S001-pricing/scenario.md

write_spec t003 "Add a helper" "Add a helper." "evals/run S001"
ap_setup_lead 1 "t003"
cat >>"$AP_WORK/lead.sh" <<W
FIX_REASON='$REASON'
wave() {
  [ -e "\$EVALS_WORK/autopilot/judged" ] && return 0
  : >"\$EVALS_WORK/autopilot/judged"
  lead_run t003
  # The lead reads S001's failure and judges it a check bug.
  local out rc
  out="\$(delegate fix-check S001 --from t003 --reason "\$FIX_REASON" 2>&1)"; rc=\$?
  { printf '\n\$ lead fix-check (exit %s)\n%s\n' "\$rc" "\$out"; } >>"\$EVALS_WORK/autopilot/lead.log"
  return 0
}
W
LEAD_GOAL="t003" ap_write_plan "true" t003

ap_start --max-waves 1
ap_wait_stopped 90 || ap_status_fail "did not stop"

fixline="$(grep '^\$ lead fix-check' "$AP_WORK/lead.log" 2>/dev/null)"
[ -n "$fixline" ] || { echo "CHECK ERROR: the stand-in lead never ran delegate fix-check (stop_reason: $(ap_get stop_reason))"; exit 3; }
case "$fixline" in
  *"(exit 0)"*) ;;
  *) fail "autopilot's lead cannot fix a check bug: delegate fix-check S001 --from t003 failed: $(grep -A3 '^\$ lead fix-check' "$AP_WORK/lead.log" | tail -3 | tr '\n' ' ')" ;;
esac

fix_call() { # the work call whose spec marks it a fix of S001's check
  local c
  for c in $(calls_where work); do
    grep -qE '^fixes_checks:.*S001' "$HOME/.cache/stub/calls/$c/spec" 2>/dev/null && { echo "$c"; return 0; }
  done
  return 1
}
wait_until 30 fix_call || fail "delegate fix-check exited 0 but no worker ran a task with a fixes_checks: S001 spec (calls: $(for c in $(calls_where work); do call_field "$c" model; done | tr '\n' ' '))"
call="$(fix_call)"
model="$(call_field "$call" model)"
case "$model" in
  deepseek-*) ;;
  *) fail "the check fix ran on '$model', not on the DeepSeek family that wrote S001's check" ;;
esac

report="$(ap_wait_report 10)" || fail "delegate autopilot status: no run report"
grep -F 'S001' "$report" | grep -qF "$REASON" ||
  fail "the run report has no line naming S001 and the fix reason '$REASON': $(grep -n 'S001\|fix' "$report" | head -3 | tr '\n' ' ')"

pass "autopilot's lead ran fix-check for S001; the fix ran on $model and the run report lists S001 with its reason"
