#!/usr/bin/env bash
# init in projects that already have Claude Code settings.
. "$EVALS_LIB/common.sh"
setup_project --no-init
mkdir -p "$PROJ/.claude"
cat >"$PROJ/.claude/settings.json" <<'J'
{
  "statusLine": {"type": "command", "command": "~/bin/my-line"},
  "permissions": {"allow": ["Bash(ls:*)"]},
  "hooks": {
    "PreToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": ": # the user's own hook"}]}
    ]
  }
}
J
cp "$PROJ/.claude/settings.json" "$EVALS_WORK/s031-settings-before.json"
d init
[ "$RC" -eq 0 ] || fail "init failed with an existing settings.json: $OUT"
python3 - "$EVALS_WORK/s031-settings-before.json" "$PROJ/.claude/settings.json" <<'PY' || exit 1
import collections, json, sys

def load(path, who):
    try:
        data = json.load(open(path))
    except Exception as e:
        print(f"FAIL: {who} settings.json is not readable JSON: {e}"); sys.exit(1)
    if not isinstance(data, dict):
        print(f"FAIL: {who} settings.json is not a JSON object"); sys.exit(1)
    return data

before = load(sys.argv[1], "the user's")
after = load(sys.argv[2], "init's")
for key, value in before.items():
    if key != "hooks" and after.get(key) != value:
        print(f"FAIL: init changed the user's setting {key}: {after.get(key)!r}"); sys.exit(1)

def entries(groups):
    return collections.Counter((group.get("matcher", ""), json.dumps(hook, sort_keys=True))
                               for group in groups if isinstance(group, dict)
                               for hook in group.get("hooks", []))

hooks = after.get("hooks") if isinstance(after.get("hooks"), dict) else {}
for event, groups in before.get("hooks", {}).items():
    groups = groups if isinstance(groups, list) else []
    now = hooks.get(event, []) if isinstance(hooks.get(event), list) else []
    missing = entries(groups) - entries(now)
    if missing:
        print(f"FAIL: init dropped or changed one of the user's {event} hooks: {sorted(missing.elements())[0]}"); sys.exit(1)
PY
echo "$OUT" | grep -q "delegate statusline" || fail "init didn't say how to add delegate's status line to the user's own: $OUT"

rm -rf "$PROJ" "$DHOME"; setup_project --no-init
mkdir -p "$PROJ/.claude"; printf '{"permissions": {"allow": ["Bash(ls:*)"]}}\n' >"$PROJ/.claude/settings.json"
d init
python3 - "$PROJ/.claude/settings.json" <<'PY' || exit 1
import json, sys
try: s = json.load(open(sys.argv[1]))
except Exception as e: print(f"FAIL: init left settings.json unreadable: {e}"); sys.exit(1)
if s.get("permissions") != {"allow": ["Bash(ls:*)"]}: print(f"FAIL: init changed the user's other settings: {s}"); sys.exit(1)
if "delegate statusline" not in (s.get("statusLine") or {}).get("command", ""): print(f"FAIL: init didn't add delegate's status line where there was none: {s}"); sys.exit(1)
PY

rm -rf "$PROJ" "$DHOME"; setup_project --no-init
mkdir -p "$PROJ/.claude"; printf '{ "statusLine": oops\n' >"$PROJ/.claude/settings.json"
before="$(sha256sum <"$PROJ/.claude/settings.json")"
d init
[ "$(sha256sum <"$PROJ/.claude/settings.json")" = "$before" ] || fail "init rewrote a settings.json it couldn't parse"
echo "$OUT" | grep -q "settings.json" || fail "init didn't say it left an invalid settings.json alone: $OUT"
pass "init kept an existing status line and other settings, added its own only where none existed, and left invalid JSON alone"
