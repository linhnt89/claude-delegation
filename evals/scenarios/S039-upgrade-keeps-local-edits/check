#!/usr/bin/env bash
# Upgrading a project whose team edited, left uncommitted and deleted kit files.
. "$EVALS_LIB/common.sh"
setup_project
cd "$PROJ"
printf '\n## Our team\nAlways run the slow suite too.\n' >>"$(skill_file delegate)"
git rm -q "$(skill_file evaluate)"
git commit -qam "Tune the delegate skill; we don't use evaluate"
printf '\nDraft: half-done local tweak.\n' >>"$(skill_file distill)"
ours="$(sha256sum "$(skill_file delegate)" "$(skill_file distill)")"
cd "$EVALS_WORK"

newer="$(newer_delegate kit2 <<'SH'
for n in delegate distill evaluate; do
  if [ -L ".claude/skills/$n" ]; then f=".agents/skills/$n/SKILL.md"; else f=".claude/skills/$n/SKILL.md"; fi
  printf "\nNew in kit 2: $n rule.\n" >>"$f"
done
printf '# kit 2\n' >>evals/run
SH
)" || exit 1
DELEGATE="$newer" fresh_kit "$EVALS_WORK/kit2"

DELEGATE="$newer" d upgrade
[ "$RC" -eq 0 ] || fail "upgrade failed: $OUT"
cd "$PROJ"
[ "$(sha256sum "$(skill_file delegate)" "$(skill_file distill)")" = "$ours" ] ||
  fail "upgrade overwrote a kit file the team edited (committed or not)"
cmp -s evals/run "$EVALS_WORK/kit2/evals/run" || fail "upgrade didn't update the untouched evals/run"
[ ! -e "$(skill_file evaluate)" ] || fail "upgrade silently added back the evaluate skill the team deleted"
for n in delegate distill; do
  echo "$OUT" | grep -qF "skills/$n/SKILL.md" || fail "upgrade's output doesn't name the edited $n skill"
done
echo "$OUT" | grep -F "skills/evaluate/SKILL.md" | grep -qiE "missing|deleted|removed" ||
  fail "upgrade's output doesn't say the evaluate skill is missing"
echo "$OUT" | grep -qE "(git )?diff" || fail "upgrade's output doesn't say how to see the difference"

# Take the new version of the one edited skill, the way the output says. The kit record may
# change with it (decision 005); every other file must not.
take="$(echo "$OUT" | grep -oE "delegate upgrade [^\`'\"]*skills/delegate/SKILL\.md" | head -1)"
[ -n "$take" ] || fail "upgrade's output gives no 'delegate upgrade ... skills/delegate/SKILL.md' command to take the new version"
before="$(kit_files "$PROJ" | grep -vE '(skills/delegate/SKILL\.md|\.delegate-kit\.toml)$')"
# shellcheck disable=SC2086
DELEGATE="$newer" d ${take#delegate }
[ "$RC" -eq 0 ] || fail "'$take' failed: $OUT"
kit2_skill="$(cd "$EVALS_WORK/kit2" && skill_file delegate)"
cmp -s "$(skill_file delegate)" "$EVALS_WORK/kit2/$kit2_skill" ||
  fail "'$take' didn't put the new version in place"
after="$(kit_files "$PROJ" | grep -vE '(skills/delegate/SKILL\.md|\.delegate-kit\.toml)$')"
[ "$before" = "$after" ] || fail "'$take' changed other files: $(diff <(echo "$before") <(echo "$after") | grep '^>' | head -2)"
pass "upgrade kept every edited or deleted kit file, named each, and took one new version on request"
