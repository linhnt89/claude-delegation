#!/usr/bin/env bash
# A background run is killed (with its worker); every view says interrupted.
. "$EVALS_LIB/common.sh"
setup_project
simple_workers standard gpt-slow gpt-slow gpt-slow
trap kill_runs EXIT
stub_worker gpt-slow <<'B'
work() { printf '\n\ndef divide_bill(a, p):\n' >>shop/pricing.py; sleep 120; }
B
write_spec t001 "Split a bill" "Add divide_bill." "python3 -m unittest -q"
bg_run t001
[ "$RC" -eq 0 ] || fail "run --background failed: $OUT"
wait_field 30 t001 phase implement || fail "setup: the run never reached implement"
pid="$(sj 's["tasks"][0]["pid"]' t001)"
kill -KILL -- -"$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null; pkill -KILL -f "$EVALS_WORK/bin/" 2>/dev/null
wait_field 5 t001 phase interrupted \
  || fail "5s after the run was killed, status --json shows '$(sj 's["tasks"][0]["phase"]' t001)', not interrupted"
d status t001
echo "$OUT" | grep -qi interrupted || fail "status doesn't say interrupted: $OUT"
echo "$OUT" | grep -q "delegate run t001" && echo "$OUT" | grep -q "delegate discard t001" \
  || fail "status doesn't say to run again or discard: $OUT"
echo "$OUT" | grep -Eqi "running|stalled|pass" && fail "status still calls the killed run running, stalled or passed: $OUT"
(cd "$PROJ" && exec "$DELEGATE" watch >"$EVALS_WORK/watch.out" 2>&1) & w=$!
sleep 2.5; kill -INT "$w" 2>/dev/null; wait "$w" 2>/dev/null
grep t001 "$EVALS_WORK/watch.out" | tail -1 | grep -qi interrupted || fail "watch doesn't show t001 interrupted: $(grep t001 "$EVALS_WORK/watch.out" | tail -1)"
d list
echo "$OUT" | grep '^t001' | grep -qi interrupt || fail "list doesn't show t001 interrupted: $(echo "$OUT" | grep '^t001')"
pass "after the background run was killed, status, watch and list all said interrupted, with what to do next"
