#!/usr/bin/env bash
# S115: a merge that turns the gate red is reverted and gets a fix task; its dependents wait,
# independent work goes on. Decision 026.
. "$EVALS_LIB/common.sh"
unset DELEGATE_AUTOPILOT DELEGATE_AUTOPILOT_WAVE
. "$EVALS_LIB/autopilot.sh"
trap ap_cleanup EXIT
ap_setup
ap_specs t001 t002 t003
ap_setup_lead 1 "t001 t002 t003" "t002=t001"

# The gate is red exactly while t001's file is in the autopilot checkout.
{ printf 'PROJ=%q\nAP=%q\n' "$PROJ" "$AP_WORK"
  cat <<'G'
wt=$(git -C "$PROJ" worktree list --porcelain | awk '/^worktree /{p=$2} /^branch refs\/heads\/autopilot$/{print p}')
head=$(git -C "$wt" log -1 --format=%s 2>/dev/null)
waves=$(wc -l <"$AP/waves" 2>/dev/null | tr -d ' ')
if [ -e "$wt/shop/t001.py" ]; then
  echo "GATE-REASON: shop/t001.py breaks the build"; echo "wave=${waves:-0} red $head" >>"$AP/gate.log"; exit 1
fi
echo ok; echo "wave=${waves:-0} green $head" >>"$AP/gate.log"
G
} >"$AP_WORK/gate.sh"
ap_write_plan "sh $AP_WORK/gate.sh" t001 t002 t003

# A faithful stand-in lead: it records its prompt, and treats a reverted task as not merged
# (the shared stand-in counts any `tNNN:` commit in the log), so a dependent of a reverted task
# waits for the fix task and other work goes on.
cat >>"$AP_WORK/lead.sh" <<'L'
printf '%s' "$*" >"$EVALS_WORK/autopilot/prompt-${DELEGATE_AUTOPILOT_WAVE:-0}"
lead_reverted() { git -C "$PWD" log --format=%s 2>/dev/null | grep -q "^Revert \"$1: "; }
lead_live() { lead_is_merged "$1" && ! lead_reverted "$1"; }
wave() {
  local id dep ok
  for id in ${LEAD_ORDER:-}; do
    lead_live "$id" && continue
    lead_reverted "$id" && continue
    lead_is_parked "$id" && continue
    ok=1
    for dep in $(lead_deps_of "$id"); do lead_live "$dep" || { ok=0; break; }; done
    [ "$ok" = 1 ] || continue
    lead_run "$id"
    lead_merge "$id"
    return 0
  done
}
L

ap_start
ap_wait_stopped 120 || ap_status_fail "did not stop"
cd "$PROJ" || { echo "CHECK ERROR: no project"; exit 3; }
revert="$(git log --format='%H %s' autopilot | grep ' Revert "t001: ' | head -1)"
[ -n "$revert" ] ||
  fail "autopilot has no 'Revert \"t001: …\"' commit after t001's merge turned the gate red (stop_reason $(ap_get stop_reason); gate runs: $(tr '\n' ';' <"$AP_WORK/gate.log" 2>/dev/null))"
[ -s "$AP_WORK/gate.log" ] && grep -q ' red ' "$AP_WORK/gate.log" || { echo "CHECK ERROR: the gate never went red"; exit 3; }
[ "$(tail -1 "$AP_WORK/gate.log" | awk '{print $2}')" = green ] ||
  fail "the gate did not pass again after the revert: $(tr '\n' ';' <"$AP_WORK/gate.log")"

# The next wave lead's prompt names a fix task for t001, the reverted commit and the gate output.
prompt="$AP_WORK/prompt-2"
[ -f "$prompt" ] || fail "no second wave lead was started after the revert (waves: $(tr '\n' ' ' <"$AP_WORK/waves"))"
p="$(tr '\n' ' ' <"$prompt")"
grep -q 't001' <<<"$p" && grep -qi 'fix' <<<"$p" ||
  fail "the next wave lead's prompt does not name a fix task for t001: $(cut -c1-300 <<<"$p")"
found=0
for sha in $(git log --format=%H autopilot --grep '^t001: ' | head -5) $(git log -1 --format=%B "${revert%% *}" | sed -n 's/.*reverts commit \([0-9a-f]*\).*/\1/p'); do
  grep -q "${sha:0:7}" <<<"$p" && found=1
done
[ "$found" = 1 ] || fail "the next wave lead's prompt does not name the reverted commit: $(cut -c1-300 <<<"$p")"
grep -qF 'GATE-REASON: shop/t001.py breaks the build' <<<"$p" ||
  fail "the next wave lead's prompt does not carry the gate output: $(cut -c1-300 <<<"$p")"

# Dependents wait, independent work goes on.
grep -q '^\$ lead run t002' "$AP_WORK/lead.log" 2>/dev/null && fail "t002 was started while t001 was reverted"
for call in "$HOME"/.cache/stub/calls/*/spec; do
  [ -f "$call" ] || continue
  grep -q '^# Task t002:' "$call" && fail "a worker ran t002 while t001 was reverted"
done
merged=" $(ap_merged | tr '\n' ' ') "
case "$merged" in *" t003 "*) ;; *) fail "the independent t003 was not merged (merged:$merged)" ;; esac

report="$(ap_wait_report 10)" || fail "delegate autopilot status: no run report"
grep -qi 'revert' "$report" && grep -q 't001' "$report" || fail "the run report does not list the revert of t001"
grep -qF 'shop/t001.py breaks the build' "$report" || fail "the run report does not give the gate output's reason for the revert"
pass "t001's merge was reverted and the gate passed again; the next wave's prompt named its fix task, the commit and the gate output; t002 waited, t003 merged; the report lists the revert"
