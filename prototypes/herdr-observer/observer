#!/usr/bin/env python3
"""Private, closed-world headless observer. Python standard library only."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import selectors
import signal
import socket
import subprocess
import sys
import tempfile
import time
import unicodedata
import uuid

VERSION = 1
MAX_OUTPUT = 2 * 1024 * 1024
MAX_STATE = 8 * 1024 * 1024
MAX_TASKS = 128
MAX_SOURCES = 8
MAX_TEXT = 4096
TIMEOUT = 10
ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,79}\Z")
HERE = Path(__file__).resolve().parent


class Failure(Exception):
    pass


def encode(value):
    return (json.dumps(value, ensure_ascii=True, allow_nan=False, separators=(",", ":")) + "\n").encode()


def load_json(raw):
    try:
        return json.loads(raw, parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
    except (ValueError, RecursionError, UnicodeError) as exc:
        raise Failure("invalid JSON") from exc


def atomic(path, data):
    if len(data) > MAX_STATE:
        raise Failure("private state limit exceeded")
    fd, name = tempfile.mkstemp(prefix=".pending-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def absolute(value):
    path = Path(value)
    if not path.is_absolute():
        raise Failure("use explicit absolute paths")
    return path.resolve()


def child_env(state):
    home = state / "home"
    return {
        "HOME": str(home), "XDG_CONFIG_HOME": str(home / ".config"),
        "XDG_DATA_HOME": str(home / ".local/share"),
        "XDG_CACHE_HOME": str(home / ".cache"),
        "XDG_STATE_HOME": str(home / ".local/state"),
        "PATH": str(state / "bin") + ":/usr/bin:/bin",
        "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TERM": "dumb",
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": str(home / ".gitconfig"),
        "GIT_TERMINAL_PROMPT": "0", "GIT_AUTHOR_NAME": "Observer test",
        "GIT_AUTHOR_EMAIL": "observer@example.test", "GIT_COMMITTER_NAME": "Observer test",
        "GIT_COMMITTER_EMAIL": "observer@example.test",
    }


def execute(argv, cwd, env, timeout=TIMEOUT):
    """Drain both pipes with one total byte/deadline budget; never invoke a shell."""
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                start_new_session=True)
    except OSError as exc:
        raise Failure("cannot start explicit tool; check setup") from exc
    out, err = bytearray(), bytearray()
    deadline = time.monotonic() + timeout
    try:
        with selectors.DefaultSelector() as selector:
            for stream, target in ((proc.stdout, out), (proc.stderr, err)):
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ, target)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Failure("tool timed out")
                for key, _ in selector.select(min(remaining, 0.1)):
                    data = os.read(key.fd, 65536)
                    if not data:
                        selector.unregister(key.fileobj)
                    else:
                        key.data.extend(data)
                        if len(out) + len(err) > MAX_OUTPUT:
                            raise Failure("tool output limit exceeded")
            proc.wait(timeout=max(0.001, deadline - time.monotonic()))
        if proc.returncode:
            # Do not parse stderr to infer absence; do not expose raw logs.
            raise Failure("explicit tool returned failure")
        return bytes(out)
    except subprocess.TimeoutExpired as exc:
        raise Failure("tool timed out") from exc
    finally:
        # Also stop descendants retaining a pipe after a failed command/deadline.
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)
        proc.wait()
        proc.stdout.close()
        proc.stderr.close()


@contextlib.contextmanager
def locked(state):
    if not (state / "config.json").is_file():
        raise Failure("missing explicit setup; run init first")
    with (state / "lock").open("a+b") as lock:
        deadline = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise Failure("observer busy; retry")
                time.sleep(0.02)
        config = load_json((state / "config.json").read_bytes())
        with (state / "state.json").open("rb") as stream:
            raw = stream.read(MAX_STATE + 1)
        if len(raw) > MAX_STATE:
            raise Failure("private state limit exceeded")
        db = load_json(raw)
        if config.get("schema_version") != VERSION or db.get("schema_version") != VERSION:
            raise Failure("unsupported private state version")
        yield config, db


def save(state, db):
    atomic(state / "state.json", encode(db))


def delegate(state, config, source, *args, timeout=TIMEOUT):
    return execute([config["delegate"], *args], source["path"], child_env(state), timeout)


def status(state, config, source, task_id=None, deadline=None):
    args = ["status"] + ([task_id] if task_id else []) + ["--json"]
    timeout = TIMEOUT if deadline is None else min(TIMEOUT, deadline - time.monotonic())
    if timeout <= 0:
        raise Failure("snapshot read budget exhausted")
    value = load_json(delegate(state, config, source, *args, timeout=timeout))
    if not isinstance(value, dict) or not isinstance(value.get("tasks"), list):
        raise Failure("invalid status envelope")
    rows = value["tasks"]
    if len(rows) > MAX_TASKS:
        raise Failure("task count limit exceeded")
    seen = set()
    for row in rows:
        # Match delegate Task::load, not the narrower wrapper-control ID policy.
        if (not isinstance(row, dict) or not isinstance(row.get("id"), str)
                or not row["id"] or row["id"].startswith(("_", "."))
                or any(c in row["id"] for c in ("/", "\\"))):
            raise Failure("invalid status task id")
        if row["id"] in seen:
            raise Failure("duplicate status task id")
        seen.add(row["id"])
    if task_id and (len(rows) != 1 or rows[0]["id"] != task_id):
        raise Failure("single-task read did not return requested task")
    return rows


def text(value):
    if not isinstance(value, str):
        raise Failure("invalid text field")
    # Never emit literal terminal controls or bidi/format controls, including ESC.
    limited = len(value) > MAX_TEXT
    return "".join("\ufffd" if (unicodedata.category(c).startswith("C")
                               or unicodedata.category(c) in ("Zl", "Zp")) else c
                   for c in value[:MAX_TEXT]), limited


def normalize(row, full):
    result = {"task_id": row["id"], "attempt_id": None}
    limited = False
    for field in ("title", "phase", "outcome", "worker"):
        val = row.get(field)
        if field in ("outcome", "worker") and val is None:
            result[field] = None
        else:
            result[field], cut = text(val)
            limited |= cut
    steps = row.get("steps")
    if not isinstance(steps, list) or not isinstance(row.get("steps_available"), bool):
        raise Failure("invalid activity fields")
    # Full individual status can reveal adapter truncation. The all-task cap cannot.
    result["steps_truncated"] = len(steps) > 5 if full or len(steps) != 5 else None
    result["steps_available"] = row["steps_available"]
    result["steps"] = []
    rejected = 0
    for step in steps[-5:]:
        try:
            if not isinstance(step, dict) or len(encode(step)) > 16384:
                raise Failure("oversized step")
            if type(step.get("id")) is not int or step["id"] < 0:
                raise Failure("invalid step id")
            normalized = {"id": step["id"]}
            for field in ("at", "kind", "target"):
                normalized[field], cut = text(step.get(field))
                limited |= cut
            if normalized["kind"] not in ("read", "edit", "run", "message", "think", "error"):
                raise Failure("unsupported activity kind")
            if step.get("result") not in (None, "ok", "failed"):
                raise Failure("unsupported activity result")
            normalized["result"] = step.get("result")
            result["steps"].append(normalized)
        except (Failure, RecursionError, ValueError, TypeError):
            rejected += 1
    result["rejected_steps"] = rejected
    result["detail_limited"] = limited or rejected > 0
    return result


def capture(endpoint, pane_id):
    request_id = str(uuid.uuid4())
    request = {"id": request_id, "method": "pane.get", "params": {"pane_id": pane_id}}
    deadline = time.monotonic() + 3
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(3)
            client.connect(endpoint)
            client.sendall(encode(request))
            raw = bytearray()
            while b"\n" not in raw:
                client.settimeout(max(0.001, deadline - time.monotonic()))
                part = client.recv(65536)
                if not part:
                    raise Failure("Herdr disconnected")
                raw.extend(part)
                if len(raw) > MAX_OUTPUT or time.monotonic() > deadline:
                    raise Failure("Herdr response limit exceeded")
    except OSError as exc:
        raise Failure("explicit Herdr endpoint unavailable") from exc
    value = load_json(bytes(raw).split(b"\n", 1)[0])
    if not isinstance(value, dict) or value.get("id") != request_id:
        raise Failure("invalid Herdr response id")
    result = value.get("result")
    if not isinstance(result, dict) or result.get("type") != "pane_info":
        raise Failure("Herdr did not return pane_info")
    pane = result.get("pane")
    if not isinstance(pane, dict) or pane.get("pane_id") != pane_id:
        raise Failure("Herdr returned another pane")
    return valid_origin(pane.get("agent_session"))


def valid_origin(origin):
    """Reject unsafe identity verbatim; never sanitize it into a different key."""
    if not isinstance(origin, dict):
        return None
    if set(("source", "agent", "kind", "value")) - origin.keys():
        return None
    if any(not isinstance(origin[k], str) or not origin[k] or len(origin[k]) > MAX_TEXT
           or any(unicodedata.category(c).startswith("C")
                  or unicodedata.category(c) in ("Zl", "Zp") for c in origin[k])
           for k in ("source", "agent", "kind", "value")):
        return None
    if origin["kind"] not in ("id", "path"):
        return None
    if origin["kind"] == "path" and not Path(origin["value"]).is_absolute():
        return None
    return {k: origin[k] for k in ("source", "agent", "kind", "value")}


def checkout_identity(state, path, deadline=None):
    timeout = TIMEOUT if deadline is None else min(TIMEOUT, deadline - time.monotonic())
    if timeout <= 0:
        raise Failure("identity read budget exhausted")
    common = execute(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                     path, child_env(state), timeout=timeout).decode().strip()
    with (Path(common) / "delegate-checkout-id").open("rb") as stream:
        raw = stream.read(128)
    return str(uuid.UUID(raw.decode().strip()))


def verify_identity(state, path, namespace, deadline=None):
    try:
        if checkout_identity(state, path, deadline) != namespace:
            raise Failure("registered checkout replaced; start a fresh experiment")
    except (OSError, ValueError, UnicodeError) as exc:
        raise Failure("registered checkout identity missing/invalid; start a fresh experiment") from exc


def source_for(state, db, path):
    resolved = str(absolute(path))
    for namespace, source in db["sources"].items():
        if resolved in source["aliases"]:
            verify_identity(state, source["path"], namespace)
            verify_identity(state, resolved, namespace)
            # Shared attribution/cache, but lifecycle operations belong to the caller's alias.
            return namespace, dict(source, path=resolved)
    raise Failure("checkout not explicitly registered")


def init(args, state):
    binary = absolute(args.delegate)
    # Preserve the explicit socket address: resolving symlinks can exceed the
    # AF_UNIX path limit (tests use a private /proc directory-fd alias).
    endpoint = Path(args.socket)
    if not endpoint.is_absolute():
        raise Failure("use explicit absolute socket path")
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise Failure("explicit delegate must be executable")
    # No implicit ambient endpoint, HOME or preexisting state adoption.
    state.mkdir(mode=0o700, parents=True, exist_ok=False)
    for path in ("home/.config/delegate", "home/.local/share", "home/.cache", "home/.local/state", "home/.pi", "bin"):
        (state / path).mkdir(parents=True, exist_ok=True)
    (state / "home/.gitconfig").write_text("[init]\n\tdefaultBranch = main\n", encoding="utf-8")
    (state / "home/.config/delegate/workers.toml").write_text(
        'planner_family = "claude"\n[quota]\ncheck = false\n'
        '[defaults]\nimplement = "standard"\nresearch = "fast"\nreview = "standard"\nplan_review = "standard"\n'
        '[implement]\nstandard = ["pi:observer-standin@high"]\n'
        '[research]\nfast = ["pi:observer-standin@high"]\n'
        '[review]\nstandard = ["pi:claude-review@high"]\n'
        '[plan_review]\nstandard = ["pi:claude-review@high"]\n', encoding="utf-8")
    stub = state / "bin/pi"
    stub.write_bytes((HERE / "standin.py").read_bytes())
    stub.chmod(0o700)
    atomic(state / "state.json", encode({"schema_version": VERSION, "generation": 0, "sources": {}}))
    atomic(state / "config.json", encode({"schema_version": VERSION, "delegate": str(binary), "socket": str(endpoint)}))
    return {"schema_version": VERSION, "state": str(state)}


def snapshot(state, config, db):
    db["generation"] += 1
    output = {"schema_version": VERSION, "generation": db["generation"], "sources": []}
    deadline = time.monotonic() + 30
    for namespace, source in sorted(db["sources"].items()):
        fresh = {}
        failed_ids = set()
        full_ok = False
        identity_ok = False
        try:
            verify_identity(state, source["path"], namespace, deadline)
            identity_ok = True
            rows = status(state, config, source, deadline=deadline)
            full_ok = True
            present = {row["id"] for row in rows}
            # Only a successful authoritative listing proves removal.
            for task_id in list(source["slots"]):
                if task_id not in present:
                    del source["slots"][task_id]
            source["cache"] = {k: v for k, v in source["cache"].items() if k in present}
            for row in rows:
                try:
                    fresh[row["id"]] = normalize(row, False)
                except Failure:
                    failed_ids.add(row["id"])
        except Failure:
            failed_ids.update(source["slots"])
        # Independent reads isolate malformed state and failed full feeds. Never infer
        # removal from an individual failure, regardless of its stderr wording.
        for task_id in sorted(failed_ids):
            if not identity_ok or task_id not in source["slots"]:
                continue
            try:
                fresh[task_id] = normalize(status(state, config, source, task_id, deadline=deadline)[0], True)
            except Failure:
                pass
        if full_ok or fresh:
            source["read_generation"] += 1
        source["cache"].update(fresh)
        ids = set(fresh) | set(source["cache"]) | set(source["slots"]) | failed_ids
        tasks = []
        for task_id in sorted(ids):
            cached = source["cache"].get(task_id)
            health = "live" if task_id in fresh else ("stale" if cached else "unavailable")
            slot = source["slots"].get(task_id, {})
            published = slot.get("state") == "published"
            row = dict(cached) if cached else {
                "task_id": task_id, "attempt_id": None, "title": None, "phase": None,
                "outcome": None, "worker": None, "steps": [], "steps_available": None,
                "steps_truncated": None, "rejected_steps": 0, "detail_limited": False,
            }
            # Opaque lookup keys must stay exact, even when display sanitization
            # collides. Recompute for cached and unavailable rows alike.
            display_id, truncated = text(task_id)
            row.update(display_task_id=display_id,
                       task_id_limited=truncated or display_id != task_id)
            row.update(checkout_namespace=namespace, health=health,
                       instance_token=slot.get("instance_token") if published else None,
                       origin=valid_origin(slot.get("origin")) if published else None)
            tasks.append(row)
        health = "live" if full_ok and all(t["health"] == "live" for t in tasks) else (
            "stale" if source["cache"] else "unavailable")
        output["sources"].append({"checkout_namespace": namespace, "read_generation": source["read_generation"],
                                  "health": health, "mode": "all" if full_ok else "registered_fallback",
                                  "tasks": tasks})
    save(state, db)
    return output


def dispatch(args):
    state = absolute(args.state)
    if args.operation == "init":
        return init(args, state)
    if args.operation == "capture":
        with locked(state) as (config, _):
            return {"schema_version": VERSION, "origin": capture(config["socket"], args.pane)}
    launch = None
    with locked(state) as (config, db):
        if args.operation == "register":
            path = absolute(args.checkout)
            source = {"path": str(path)}
            for known_namespace, known_source in db["sources"].items():
                if str(path) in known_source["aliases"]:
                    verify_identity(state, known_source["path"], known_namespace)
                    verify_identity(state, path, known_namespace)
            status(state, config, source)  # explicit initialization before identity read
            namespace = checkout_identity(state, path)
            if namespace in db["sources"]:
                # A new linked alias must not silently rebind a lost read location.
                verify_identity(state, db["sources"][namespace]["path"], namespace)
            where = delegate(state, config, source, "where").decode().splitlines()
            homes = [line.split(None, 1)[1] for line in where if line.startswith("tasks\t") or line.startswith("tasks ")]
            if len(homes) != 1 or not Path(homes[0]).name.startswith(namespace + "-"):
                raise Failure("unregistered or inconsistent checkout identity")
            expected = state / "home/.local/share/delegate/checkouts"
            if Path(homes[0]).parent.resolve() != expected.resolve():
                raise Failure("task home outside isolated root")
            if namespace not in db["sources"]:
                if len(db["sources"]) >= MAX_SOURCES:
                    raise Failure("checkout count limit exceeded")
                db["sources"][namespace] = {"path": str(path), "aliases": [], "slots": {}, "cache": {}, "read_generation": 0}
            source = db["sources"][namespace]
            if str(path) not in source["aliases"]:
                if len(source["aliases"]) >= 16:
                    raise Failure("linked-worktree alias limit exceeded")
                source["aliases"].append(str(path))
            save(state, db)
            return {"checkout_namespace": namespace}
        if args.operation == "snapshot":
            return snapshot(state, config, db)
        namespace, source = source_for(state, db, args.checkout)
        if not ID.fullmatch(args.id):
            raise Failure("invalid bounded task id")
        if args.operation == "create":
            # Absence preflight must precede even the pending write. Shared UUID and
            # lock make duplicate creation through a linked worktree non-destructive.
            rows = status(state, config, source)
            if any(row["id"] == args.id for row in rows):
                raise Failure("task already exists; attribution unchanged")
            if len(rows) >= MAX_TASKS:
                raise Failure("checkout task count limit reached")
            if len(source["slots"]) >= MAX_TASKS and args.id not in source["slots"]:
                raise Failure("registered task limit exceeded")
            origin = capture(config["socket"], args.pane)
            source["slots"][args.id] = {"state": "pending"}
            source["cache"].pop(args.id, None)
            save(state, db)
            delegate(state, config, source, "new", args.id)
            if args.test_crash_after_new:
                os._exit(86)
            token = str(uuid.uuid4())
            source["slots"][args.id] = {"state": "published", "instance_token": token, "origin": origin}
            save(state, db)
            return {"checkout_namespace": namespace, "task_id": args.id, "instance_token": token, "origin": origin}
        if args.operation == "discard":
            if len(source["slots"]) >= MAX_TASKS and args.id not in source["slots"]:
                raise Failure("registered task limit exceeded")
            source["slots"][args.id] = {"state": "retiring"}
            source["cache"].pop(args.id, None)
            save(state, db)
            delegate(state, config, source, "discard", args.id)
            if args.test_crash_after_discard:
                os._exit(86)
            source["slots"].pop(args.id, None)
            source["cache"].pop(args.id, None)
            save(state, db)
            return {"checkout_namespace": namespace, "task_id": args.id, "retired": True}
        if args.id not in source["slots"]:
            raise Failure("run requires wrapper-created task")
        # Run/retry is an explicit setup control, not an observation. The lock is
        # released before waiting for the worker, so snapshots can continue.
        launch = (dict(config), dict(source))
    config, source = launch
    delegate(state, config, source, "run", args.id, "--research", "--worker", "pi:observer-standin@high", timeout=60)
    return {"checkout_namespace": namespace, "task_id": args.id, "run_completed": True}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--state", required=True, help="absolute private experiment directory (no ambient defaults)")
    subs = parser.add_subparsers(dest="operation", required=True)
    setup = subs.add_parser("init", help="explicit private stand-in setup; directory must not exist")
    setup.add_argument("--delegate", required=True, help="absolute source-built delegate executable")
    setup.add_argument("--socket", required=True, help="absolute opt-in UNIX API endpoint")
    register = subs.add_parser("register", help="initialize and register an explicit disposable checkout")
    register.add_argument("--checkout", required=True)
    capture_parser = subs.add_parser("capture", help="opt-in read of selected pane's reported identity")
    capture_parser.add_argument("--pane", required=True)
    for name in ("create", "run", "discard"):
        sub = subs.add_parser(name, help={"create": "capture once and delegate new", "run": "explicit scrubbed stand-in run/retry", "discard": "explicit delegate discard and retire"}[name])
        sub.add_argument("--checkout", required=True)
        sub.add_argument("--id", required=True)
        if name == "discard":
            sub.add_argument("--test-crash-after-discard", action="store_true", help="TEST ONLY: exit 86 after removal before retirement (default off)")
        if name == "create":
            sub.add_argument("--pane", required=True)
            sub.add_argument("--test-crash-after-new", action="store_true", help="TEST ONLY: exit 86 before publishing attribution (default off)")
    subs.add_parser("snapshot", help="bounded read-only JSON snapshot; only delegate status dispatches")
    args = parser.parse_args()
    try:
        result = dispatch(args)
        raw = encode(result)
        if len(raw) > MAX_STATE:
            raise Failure("snapshot limit exceeded")
        sys.stdout.buffer.write(raw)
        return 0
    except (Failure, OSError, ValueError, KeyError, TypeError) as exc:
        # No raw delegate stderr, task content, or endpoint response is printed.
        detail = str(exc) if isinstance(exc, Failure) else type(exc).__name__
        print("observer: " + detail + "; check explicit setup/limits and retry", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
