#!/usr/bin/env python3
"""Offline, headless smoke gate: 0 pass, 1 assertion, 3 setup/tool failure."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent
binary = ROOT / "delegate/target/release/delegate"
try:
    override = os.environ.get("DELEGATE")
    if override:
        if Path(override).resolve() != binary.resolve() or not binary.is_file():
            raise RuntimeError("DELEGATE must select this checkout's source-built release binary")
    else:
        # Build before HOME isolation, matching evals/lib/common.sh's delegate_bin.
        env = dict(os.environ)
        env["MISE_STATE_DIR"] = env.get("MISE_STATE_DIR", str(Path.home() / ".cache/mise-state"))
        env["MISE_TRUSTED_CONFIG_PATHS"] = str(ROOT / "delegate")
        with tempfile.TemporaryFile() as log:
            proc = subprocess.run(["mise", "exec", "--", "cargo", "build", "-q", "--release", "--offline"],
                                  cwd=ROOT / "delegate", env=env, stdout=log, stderr=log, timeout=180)
            if proc.returncode:
                log.seek(0)
                sys.stderr.buffer.write(log.read(16384))
                raise RuntimeError("offline delegate build failed")
    if not os.access(binary, os.X_OK):
        raise RuntimeError("source-built delegate missing")
    # bwrap is required, never silently disable the production worker sandbox.
    subprocess.run(["bwrap", "--ro-bind", "/", "/", "--", "/usr/bin/true"],
                   check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10)
    env = dict(os.environ, OBSERVER_TEST_DELEGATE=str(binary), PYTHONDONTWRITEBYTECODE="1")
    result = subprocess.run([sys.executable, str(HERE / "smoke.py")], env=env)
    sys.exit(result.returncode)
except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
    print("SETUP FAILURE: " + str(exc), file=sys.stderr)
    sys.exit(3)
